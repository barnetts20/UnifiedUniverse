// UniWebTexture.ush
// D-164: the web density texture (and, D-179, the galaxy textures): the only textures the shared cores may sample. Every .usf that
// includes a core includes this first (after Platform.ush). Cores never name the texture; they
// call UNI_WEB_TEX_SAMPLE(P, Mip), which the C++ shim (UniHlslShim.h) defines as the same
// filter over the CPU copy of the same texels, so placement and rendering stay one source.
//
// Texture: RGBA16F, cubic, full mip chain, texel (i + 0.5) / N per period. Channels: R walls,
// G filaments (both mixed over the two lattices), B nodes, A unused (UniCore::FWebTexture).
// Sampler: wrap on all axes, trilinear with linear mip filtering (UniRenderer binds
// TStaticSamplerState<SF_Trilinear, AM_Wrap, AM_Wrap, AM_Wrap>). Shaders that never sample a
// field strip both, so they need no binding.

#ifndef UNI_WEB_TEXTURE_USH
#define UNI_WEB_TEXTURE_USH

Texture3D<float4> UniWebTexture;
SamplerState UniWebSampler;

#define UNI_WEB_TEX_SAMPLE(P, Mip) UniWebTexture.SampleLevel(UniWebSampler, (P), (Mip))

// D-179: the galaxy textures, sampled by the galaxy field only (UniField_GalaxyFiltered), with the
// same wrap / trilinear sampler: warp_fine and warp_large (curl displacement in RGB, fBm in A),
// galaxy_detail (R ridged lanes, G star-forming knots, B fBm, A superbubbles). RGBA16F with full
// mips, uploaded like the web texture (UniWebTexUpload.usf); unbound: a 1^3 NaN dummy.
Texture3D<float4> UniGalWarpFine;
Texture3D<float4> UniGalWarpLarge;
Texture3D<float4> UniGalDetail;

#define UNI_GAL_WARP_FINE(P, Mip) UniGalWarpFine.SampleLevel(UniWebSampler, (P), (Mip))
#define UNI_GAL_WARP_LARGE(P, Mip) UniGalWarpLarge.SampleLevel(UniWebSampler, (P), (Mip))
#define UNI_GAL_DETAIL(P, Mip) UniGalDetail.SampleLevel(UniWebSampler, (P), (Mip))

// D-212: the galaxy map (UniFields.ush, Uni_GalaxyMapEval): RGBA16F 2D with mips over the field's
// x, y in [-1, 1]; the same wrap / trilinear sampler (its border is zero: outside the cut).
// D-214: an array of slots, one galaxy's map each (UniCore::FGalaxyMapCache): the volume reads
// the camera's galaxy's, generation the map of each galaxy it places stars in.
Texture2DArray<float4> UniGalMap;

#define UNI_GAL_MAP(UV, Slot, Mip) UniGalMap.SampleLevel(UniWebSampler, float3((UV), (float)(Slot)), (Mip))

#endif // UNI_WEB_TEXTURE_USH
