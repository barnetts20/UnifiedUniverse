// UniProject.usf
// Project and cull, every frame, every resident object: one group of 64 per resident cell,
// looping over the cell's pool range. All per-object logic is Uni_ProjectObject in
// Core/UniProject.ush, shared with the CPU reference renderer (Tier 3).
//
// Outputs: compacted sprites + an indirect draw argument block {6, instances, 0, 0}, and
// promotion candidates (cell index, object index in cell) for the CPU readback.
//
// The view is passed as raw floats and rebuilt here (lesson #2: no derived struct mirrored as a
// constant buffer). The cell table carries exact 128-bit deltas (D-104).

#include "/Engine/Public/Platform.ush"
#include "UniWebTexture.ush"   // D-164: before any core (UniFields.ush samples it)
#include "Core/UniProject.ush"
#include "Core/UniSystem.ush"

struct FUniCellGPU   // GPU-MIRROR: UniCore::FCellGPU (64 bytes)
{
	uint4 DeltaX;
	uint4 DeltaY;
	uint4 DeltaZ;
	uint Level;
	uint PoolStart;
	uint PoolCount;
	uint Flags;      // bit 0 suspended, bits 8..15 level fade
};

StructuredBuffer<FUniCellGPU> InCells;
StructuredBuffer<FUniObject> InPool;
RWStructuredBuffer<FUniSprite> OutSprites;
RWBuffer<uint> OutDrawArgs;          // {VertexCountPerInstance, InstanceCount, StartVertex, StartInstance}
RWStructuredBuffer<uint2> OutPromote;
RWBuffer<uint> OutPromoteCount;
RWStructuredBuffer<uint2> OutActivate;          // D-142: (cell index, object index) of stars inside their system radius
RWStructuredBuffer<FUniObject> OutActivateRecord; // and their records, for the CPU (star records otherwise never leave the GPU)
RWBuffer<uint> OutActivateCount;

uint NumCells;
uint DispatchGroupsX;
uint MaxSprites;
uint MaxPromote;
uint MaxActivate;
uint SystemArchetypeMask;                        // bit per archetype id < 32 whose objects have systems
float WarpAmount;                                // D-187: warp 0..1 (0: at rest, every sprite as before)
float4 WarpVelBeta;                              // D-190: warp optics: the camera's motion (unit), effective speed (0: none)
float4 WarpDopplerKQ;                            // D-190: Doppler colour strength, beaming exponent
float ArrivalFrames;                             // D-187: frames over which a new cell's objects arrive at warp
uint DiscArchetypeMask;                          // D-183: bit per archetype id < 32 whose objects are disc galaxies (inclined elliptical sprites)
uint4 FixedDiscSeeds;                            // D-183: seeds of fixed-orientation anchors (disc normal world z)

float3 ViewForward;
float TanHalfFovX;
float3 ViewRight;
float TanHalfFovY;
float3 ViewUp;
float LimitingMag;
float3 CameraFraction;
float ExposureMag;
float SurfaceLimit;
float ThetaPixel;
float SpriteCorePx;       // D-156 sprite style (uu.Sprite.*)
float SpriteCoreSat;
float SpriteHaloGain;
float SpriteHaloGrowthPx;
float SpriteHaloMaxPx;

[numthreads(64, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint CellIndex = GroupId.y * DispatchGroupsX + GroupId.x;
	if (CellIndex == 0 && GroupIndex == 0) { OutDrawArgs[0] = 6; }   // two triangles per sprite
	if (CellIndex >= NumCells) { return; }
	const FUniCellGPU Cell = InCells[CellIndex];

	FUniView V;
	V.Forward = ViewForward;
	V.TanHalfFovX = TanHalfFovX;
	V.Right = ViewRight;
	V.TanHalfFovY = TanHalfFovY;
	V.Up = ViewUp;
	V.LimitingMag = LimitingMag;
	V.CameraFraction = CameraFraction;
	V.ExposureMag = ExposureMag;
	V.SurfaceLimit = SurfaceLimit;
	V.ThetaPixel = ThetaPixel;
	V.CorePx = SpriteCorePx;
	V.CoreSat = SpriteCoreSat;
	V.HaloGain = SpriteHaloGain;
	V.HaloGrowthPx = SpriteHaloGrowthPx;
	V.HaloMaxPx = SpriteHaloMaxPx;
	V.SystemArchetypeMask = SystemArchetypeMask;
	V.DiscArchetypeMask = DiscArchetypeMask;
	V.FixedDiscSeeds = FixedDiscSeeds;
	V.WarpVel = WarpVelBeta.xyz;
	V.WarpBeta = WarpVelBeta.w;
	V.WarpDoppler = WarpDopplerKQ.x;
	V.WarpBeaming = WarpDopplerKQ.y;
	V.WarpPad0 = 0.0f;
	V.WarpPad1 = 0.0f;

	// D-187: at warp a new cell's objects arrive over ArrivalFrames (faded in, streaking in from
	// ahead: the sprite pass stretches their tails by their arrival); at rest nothing changes.
	const float Arrival = Uni_SpriteArrival((Cell.Flags >> UNI_CELL_AGE_SHIFT) & 255u, ArrivalFrames);
	const float LevelFade = (float)((Cell.Flags >> 8u) & 255u) / 255.0f * lerp(1.0f, Arrival, saturate(WarpAmount));
	const uint ArrivalBits = (uint)(Arrival * 255.0f + 0.5f) << UNI_SPRITE_ARRIVAL_SHIFT;
	for (uint I = GroupIndex; I < Cell.PoolCount; I += 64)
	{
		const FUniObject O = InPool[Cell.PoolStart + I];
		FUniSprite S = Uni_ProjectObject(Cell.DeltaX, Cell.DeltaY, Cell.DeltaZ, Cell.Level, LevelFade, O, V,
			(Uni_ObjectFlags(O) & UNI_OBJ_FLAG_PROMOTED) != 0u);
		S.Flags = S.Flags | ArrivalBits;
		// System activation: by true distance, before any culling (a system behind the camera
		// still activates). Dynamic planet records carry an archetype id >= 32 and never match.
		if (SystemArchetypeMask != 0u && (Uni_ObjectFlags(O) & UNI_OBJ_FLAG_DELTA_HIDDEN) == 0u && Uni_SystemActivates(Uni_ObjectArchetype(O), SystemArchetypeMask, Uni_ObjectAbsMag(O), S.TrueDistance))
		{
			uint A;
			InterlockedAdd(OutActivateCount[0], 1u, A);
			if (A < MaxActivate) { OutActivate[A] = uint2(CellIndex, I); OutActivateRecord[A] = O; }
		}
		if ((S.Flags & UNI_SPRITE_PROMOTE_CANDIDATE) != 0u)
		{
			uint P;
			InterlockedAdd(OutPromoteCount[0], 1u, P);
			if (P < MaxPromote) { OutPromote[P] = uint2(CellIndex, I); }
		}
		if ((S.Flags & UNI_SPRITE_VISIBLE) != 0u)
		{
			uint Slot;
			InterlockedAdd(OutDrawArgs[1], 1u, Slot);
			if (Slot < MaxSprites) { OutSprites[Slot] = S; }
		}
	}
}
