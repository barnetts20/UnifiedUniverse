// UniGen.usf
// GPU generation: one thread group of 64 per task (cell, contributor, emitter). Orchestration
// only; every decision is in the shared cores (Core/UniGenTask.ush), which the CPU reference
// runs in the same order (UniGenRef.h, verified offline by Tier 2).
//
//   UNI_GEN_PASS 0  PROBE: 128 probes (2 per thread), group reduction to sum and max,
//                   Uni_TaskCount -> OutCounts[task]. Read back; the CPU allocates pool ranges.
//   UNI_GEN_PASS 1  PLACE: candidates in chunks of 64; a group-wide inclusive scan of the
//                   accept flags gives each accepted candidate its rank, so ranks follow
//                   candidate index exactly as the CPU's sequential loop does. The first
//                   PoolCapacity accepted are written; the rest of the range is blanked
//                   (lesson #27). OutAccepted[task] = filled count.
//   UNI_GEN_PASS 2  SCATTER: authored records (anchors) written at CPU-chosen pool indices.
//   UNI_GEN_PASS 3  ALLOC (D-207, one-trip batches): one thread walks the batch's cells in order
//                   and gives every task its pool range inside the arena the CPU reserved,
//                   exactly as FuseAllocate (UniStreamer.h). PLACE then reads the ranges from
//                   InAlloc (UseAlloc 1) instead of the task, so probe, allocation and place run
//                   back to back and only the counts are read back.
//
// Dispatch is wrapped into 2D (lesson #23): task = GroupId.y * DispatchGroupsX + GroupId.x.
// Padding groups (TaskIndex >= NumTasks) do NOT return early: every thread of every group
// reaches every barrier, with the work counts forced to zero and the writes masked (UE review
// S1: FXC rejects barriers after a return, and some drivers hang on them). Loops that contain
// barriers have a trip count read from the task, which is group-uniform, and are bounded.
// Parity note (D-105): the probe sum is a tree reduction here and a sequential sum on the CPU,
// so mean and lambda differ in the last bits and a Poisson count can differ in rare boundary
// cases. Integer parts (seeds, offsets, ranks) are bit-identical.

#include "/Engine/Public/Platform.ush"
#include "UniWebTexture.ush"   // D-164: before any core (UniFields.ush samples it)
#include "Core/UniGenTask.ush"

#ifndef UNI_GEN_PASS
	#define UNI_GEN_PASS 0
#endif

#define UNI_GEN_THREADS 64

StructuredBuffer<FUniGenTask> InTasks;
uint NumTasks;
uint DispatchGroupsX;

#if UNI_GEN_PASS == 0

RWStructuredBuffer<FUniTaskCount> OutCounts;
groupshared float GsSum[UNI_GEN_THREADS];
groupshared float GsMax[UNI_GEN_THREADS];

[numthreads(UNI_GEN_THREADS, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint TaskIndex = GroupId.y * DispatchGroupsX + GroupId.x;
	const bool bValid = TaskIndex < NumTasks;   // group-uniform
	const FUniGenTask T = InTasks[min(TaskIndex, NumTasks - 1)];
	const uint NumProbes = bValid ? UNI_PROBES_PER_CELL : 0u;

	float Sum = 0.0f;
	float Max = 0.0f;
	for (uint K = GroupIndex; K < NumProbes; K += UNI_GEN_THREADS)
	{
		const float V = Uni_TaskProbe(T, K);
		Sum += V;
		Max = max(Max, V);
	}
	GsSum[GroupIndex] = Sum;
	GsMax[GroupIndex] = Max;
	GroupMemoryBarrierWithGroupSync();
	for (uint Stride = UNI_GEN_THREADS / 2; Stride > 0; Stride >>= 1)
	{
		if (GroupIndex < Stride)
		{
			GsSum[GroupIndex] += GsSum[GroupIndex + Stride];
			GsMax[GroupIndex] = max(GsMax[GroupIndex], GsMax[GroupIndex + Stride]);
		}
		GroupMemoryBarrierWithGroupSync();
	}
	if (bValid && GroupIndex == 0)
	{
		OutCounts[TaskIndex] = Uni_TaskCount(T, GsSum[0], GsMax[0]);
	}
}

#elif UNI_GEN_PASS == 1

StructuredBuffer<FUniTaskCount> InCounts;
StructuredBuffer<FUniSlice> InSlices;
StructuredBuffer<float> InLut;
RWStructuredBuffer<FUniObject> OutPool;
RWStructuredBuffer<uint> OutAccepted;
StructuredBuffer<uint4> InAlloc;   // D-207: (pool base, capacity, index base, fits) per task, with UseAlloc
uint UseAlloc;

groupshared uint GsScan[UNI_GEN_THREADS];
groupshared uint GsBase;

[numthreads(UNI_GEN_THREADS, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint TaskIndex = GroupId.y * DispatchGroupsX + GroupId.x;
	const bool bValid = TaskIndex < NumTasks;   // group-uniform
	const uint TaskRead = min(TaskIndex, NumTasks - 1);
	FUniGenTask T = InTasks[TaskRead];
	if (UseAlloc != 0u)
	{
		// D-207: the range ALLOC gave this task on the GPU (a one-trip batch).
		const uint4 Al = InAlloc[TaskRead];
		T.PoolBase = Al.x;
		T.PoolCapacity = Al.y;
		T.IndexBase = Al.z;
	}
	const FUniTaskCount C = InCounts[TaskRead];
	const FUniSlice S = InSlices[T.SliceIndex];
	const uint Capacity = bValid ? T.PoolCapacity : 0u;
	// At least one chunk whenever there is capacity, as the CPU loop's first iteration.
	const uint MaxChunks = (Capacity > 0u) ? max(1u, (C.CandidateBudget + UNI_GEN_THREADS - 1u) / UNI_GEN_THREADS) : 0u;

	if (GroupIndex == 0) { GsBase = 0; }
	GroupMemoryBarrierWithGroupSync();

	[loop]
	for (uint Chunk = 0; Chunk < MaxChunks; ++Chunk)
	{
		const uint J = Chunk * UNI_GEN_THREADS + GroupIndex;
		uint3 Offset = uint3(0, 0, 0);
		float Density = 0.0f;
		bool bAccepted = false;
		if (J < C.CandidateBudget)
		{
			bAccepted = Uni_TaskCandidate(T, C.Envelope, J, Offset, Density);
		}
		// Inclusive scan of accept flags (Hillis-Steele): rank = acceptance order.
		GsScan[GroupIndex] = bAccepted ? 1u : 0u;
		GroupMemoryBarrierWithGroupSync();
		[unroll]
		for (uint Off = 1; Off < UNI_GEN_THREADS; Off <<= 1)
		{
			const uint Add = (GroupIndex >= Off) ? GsScan[GroupIndex - Off] : 0u;
			GroupMemoryBarrierWithGroupSync();
			GsScan[GroupIndex] += Add;
			GroupMemoryBarrierWithGroupSync();
		}
		const uint Base = GsBase;
		const uint Rank = Base + GsScan[GroupIndex] - (bAccepted ? 1u : 0u);
		if (bAccepted && Rank < Capacity)
		{
			// if/else, not ?: (HLSL 2021 / DXC: the conditional operator takes numeric types only).
			if (Uni_TaskSuppressed(T, Offset)) { OutPool[T.PoolBase + Rank] = Uni_BlankObject(); }
			else { OutPool[T.PoolBase + Rank] = Uni_TaskMakeObject(T, S, InLut, Rank, Offset); }
		}
		const uint ChunkTotal = GsScan[UNI_GEN_THREADS - 1];
		GroupMemoryBarrierWithGroupSync();
		if (GroupIndex == 0) { GsBase = Base + ChunkTotal; }
		GroupMemoryBarrierWithGroupSync();
		// Early out once the range is full. Every thread reads the same GsBase after the
		// barrier, so the break is group-uniform; if a compiler still rejects it (X4026 on FXC),
		// delete this line: the rank test above already stops the writes, at the cost of
		// evaluating the rest of the budget.
		if (GsBase >= Capacity) { break; }
	}

	const uint Filled = min(GsBase, Capacity);
	for (uint I = Filled + GroupIndex; I < Capacity; I += UNI_GEN_THREADS)
	{
		OutPool[T.PoolBase + I] = Uni_BlankObject();
	}
	if (bValid && GroupIndex == 0) { OutAccepted[TaskIndex] = Filled; }
}

#elif UNI_GEN_PASS == 3

StructuredBuffer<FUniTaskCount> InCounts;
RWStructuredBuffer<uint4> OutAlloc;
uint ArenaBase;
uint ArenaCap;
uint MaxPerCell;

/** D-207: FuseAllocate (UniStreamer.h), line for line. Cells are runs of tasks with the same
 *  ordinal (BoxLo.w), in order. A task's capacity is its count truncated so its cell holds at
 *  most MaxPerCell; its index base the running sum before it in the cell. A cell whose total fits
 *  in the arena's remaining room is packed at the cursor; otherwise its tasks get capacity 0 and
 *  the next cells still try. One thread: a batch is at most a few thousand tasks. */
[numthreads(1, 1, 1)]
void AllocCS()
{
	uint Cursor = 0u;
	uint I = 0u;
	[loop]
	while (I < NumTasks)
	{
		const uint Cell = InTasks[I].BoxLo.w;
		uint J = I;
		uint Index = 0u;
		[loop]
		for (; J < NumTasks; ++J)
		{
			if (InTasks[J].BoxLo.w != Cell) { break; }
			const uint Room = Index < MaxPerCell ? MaxPerCell - Index : 0u;
			Index += min(InCounts[J].Count, Room);
		}
		const bool bFits = Index <= ArenaCap - Cursor;
		uint Idx = 0u;
		[loop]
		for (uint K = I; K < J; ++K)
		{
			const uint Room = Idx < MaxPerCell ? MaxPerCell - Idx : 0u;
			const uint Cap = min(InCounts[K].Count, Room);
			if (bFits) { OutAlloc[K] = uint4(ArenaBase + Cursor + Idx, Cap, Idx, 1u); }
			else { OutAlloc[K] = uint4(ArenaBase, 0u, Idx, 0u); }
			Idx += Cap;
		}
		if (bFits) { Cursor += Index; }
		I = J;
	}
}

#else // UNI_GEN_PASS == 2: scatter authored records (anchors) into the pool

StructuredBuffer<uint> InScatterIndex;
StructuredBuffer<FUniObject> InScatterRecord;
RWStructuredBuffer<FUniObject> OutPool;
uint NumWrites;

[numthreads(64, 1, 1)]
void ScatterCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= NumWrites) { return; }
	OutPool[InScatterIndex[ThreadId.x]] = InScatterRecord[ThreadId.x];
}

#endif
