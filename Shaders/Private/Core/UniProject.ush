// UniProject.ush
// Project and cull: one resident object -> one sprite (or nothing). Shared by the GPU pass
// (UniProject.usf, every frame, every resident object) and the CPU reference renderer.
//
//   1. Exact camera-relative vector: per-cell 128-bit delta + offset in integer, one float
//      conversion (D-104). r and direction from it, overflow-safe.
//   2. Apparent magnitude; surface brightness for resolved extended sources. Cull past the
//      limit, outside the frustum, promoted, or delta-hidden.
//   3. Render position p = d * f(r) and angular radius (unchanged by compression: scaling
//      about the eye preserves projection, so parallax is exact by construction).
//   4. Intensity in exposure-calibrated units (lesson #36), faded across the band and by the
//      level fade. Fades are render-only (lesson #12).
//   5. Promotion candidate test, with hysteresis: promote at r - R < r0 or R / r > theta_p,
//      demote at 1.25x both.

#ifndef UNI_PROJECT_USH
#define UNI_PROJECT_USH

#include "UniCoreDefs.ush"
#include "UniCoord.ush"
#include "UniPhotometry.ush"
#include "UniPlacement.ush"
#include "UniSystem.ush"

static const float UNI_THETA_PROMOTE = 0.02f;     // rad: angular size that promotes to an actor (D-119)
static const float UNI_PROMOTE_HYSTERESIS = 1.25f;

static const uint UNI_SPRITE_VISIBLE = 1u;
static const uint UNI_SPRITE_PROMOTE_CANDIDATE = 2u;
static const uint UNI_SPRITE_EXTENDED = 4u;
static const uint UNI_SPRITE_BODY = 8u;           // D-148: a resolved body (extended, no children): disc profile
static const uint UNI_SPRITE_HALO_ONLY = 16u;     // D-158: a promoted star: its actor draws the disc, the sprite keeps its glare
static const float UNI_SPRITE_DISC_MIN_PX = 1.5f; // below this a body is drawn as a plain Gaussian
static const float UNI_ARRIVAL_RANGE = 4.0f;      // D-150: the brightness boost fades over the last 4x in distance

// D-156 sprite style defaults (the owner tunes them live: uu.Sprite.*).
static const float UNI_SPRITE_CORE_PX = 1.0f;         // core sigma, px: an unresolved source is a pinpoint
static const float UNI_SPRITE_CORE_SAT = 16.0f;       // intensity (exposure units) where the core saturates: 3 mag over exposure
static const float UNI_SPRITE_HALO_GAIN = 0.25f;      // halo energy per doubling over saturation (x saturation)
static const float UNI_SPRITE_HALO_GROWTH_PX = 0.5f;  // halo sigma growth per doubling over saturation, px
static const float UNI_SPRITE_HALO_MAX_PX = 4.0f;     // halo sigma cap, px


/** D-150: the distance at which an object's sprite must be back at its true perceived size.
 *  A star whose archetype has systems: its activation radius, where its planets spawn. Anything
 *  else: its promotion distance, where an actor replaces the sprite (R / theta_promote). */
UNI_FN float Uni_ArrivalDistance(uint InArchetypeId, uint InSystemArchetypeMask, float InAbsMag, float InRadius)
{
	const float Promote = InRadius / UNI_THETA_PROMOTE;
	if (InArchetypeId < 32u && ((InSystemArchetypeMask >> InArchetypeId) & 1u) != 0u)
	{
		return max(Uni_SystemActivationRadius(InAbsMag), Promote);
	}
	return Promote;
}

/** D-150: 0 far out (full brightness boost), 1 at and inside the arrival distance (true size),
 *  smooth in log distance over the last UNI_ARRIVAL_RANGE. */
UNI_FN float Uni_ArrivalWeight(float InDistance, float InArrival)
{
	return 1.0f - smoothstep(0.0f, 1.0f, log(max(InDistance, 1.0f) / max(InArrival, 1.0f)) / log(UNI_ARRIVAL_RANGE));
}

struct FUniView
{
	float3 Forward;
	float TanHalfFovX;
	float3 Right;
	float TanHalfFovY;
	float3 Up;
	float LimitingMag;        // m_lim = m_ref + dm
	float3 CameraFraction;    // sub-cm part of the camera position, [0, 1) cm
	float ExposureMag;        // magnitude that maps to intensity 1
	float SurfaceLimit;       // mu_lim = mu_ref + dm
	float ThetaPixel;         // angular radius of one pixel: minimum sprite footprint
	uint SystemArchetypeMask; // D-150: archetypes whose objects arrive at their system radius (UniSystem.ush)
	// D-156 sprite style: a pinpoint core plus a capped halo (Uni_SpriteDefaults sets these).
	float CorePx;             // core sigma for an unresolved source, pixels (<= 0: UNI_SPRITE_CORE_PX)
	float CoreSat;            // intensity at which the core saturates (<= 0: physical: no saturation, no halo)
	float HaloGain;           // halo energy per doubling of intensity over saturation, in units of saturation
	float HaloGrowthPx;       // halo sigma growth per doubling over saturation, pixels
	float HaloMaxPx;          // halo sigma cap for an unresolved source, pixels
};

struct FUniSprite
{
	float3 RenderPos;         // camera-relative, compressed: dir * f(r)
	float AngularRadius;      // rad, for the sprite quad (render size = AngularRadius * f(r))
	float3 Radiance;          // colour / luminance * intensity, exposure-calibrated (D-135)
	float TrueDistance;       // cm, for the scene-depth test
	float NdcX;               // [-1, 1] across the view
	float NdcY;
	uint Flags;
	float PhysAngularRadius;  // R / r, rad (promotion, volumetric hand-off)
	float HaloRadius;         // D-156: halo sigma, rad (0: no halo)
	float HaloRatio;          // D-156: halo energy / core energy (0: no halo)
	float Pad0;
	float Pad1;
};

/** D-156: FUniView with the default sprite style. */
UNI_FN FUniView Uni_SpriteDefaults(FUniView InView)
{
	FUniView V = InView;
	V.CorePx = UNI_SPRITE_CORE_PX;
	V.CoreSat = UNI_SPRITE_CORE_SAT;
	V.HaloGain = UNI_SPRITE_HALO_GAIN;
	V.HaloGrowthPx = UNI_SPRITE_HALO_GROWTH_PX;
	V.HaloMaxPx = UNI_SPRITE_HALO_MAX_PX;
	return V;
}

UNI_FN float Uni_SpriteCorePx(FUniView InView)
{
	return InView.CorePx > 0.0f ? InView.CorePx : UNI_SPRITE_CORE_PX;
}

/** D-156: the core's energy for an intensity, saturating at Sat with a sharp knee:
 *  I / (1 + (I / Sat)^4)^(1/4): within 0.01% of I below Sat / 8, 0.84 Sat at Sat, Sat far above it. */
UNI_FN float Uni_SpriteSaturate(float InIntensity, float InSat)
{
	const float X = min(InIntensity / InSat, 1.0e4f);   // X^4 stays finite; past 1e4 the result is Sat to 1e-16
	const float X2 = X * X;
	return InSat * X * rsqrt(sqrt(1.0f + X2 * X2));
}

/** Promotion test with hysteresis. */
UNI_FN bool Uni_PromoteTest(float InDistance, float InRadius, bool InWasPromoted)
{
	const float H = InWasPromoted ? UNI_PROMOTE_HYSTERESIS : 1.0f;
	return (InDistance - InRadius < UNI_R0_CM * H) || (InRadius / InDistance > UNI_THETA_PROMOTE / H);
}

/** Volume handoff (D-129): weight of an extended object's light carried by its volume
 *  carrier instead of its sprite. A smoothstep in angular radius from Theta1 / 2 to Theta1,
 *  Theta1 = min(8 px, theta_promote), so the ramp always completes before the promotion
 *  threshold, at any resolution. The CPU carrier builder calls this same function. */
static const float UNI_VOL_HANDOFF_PX = 8.0f;

UNI_FN float Uni_CarrierHandoff(float InPhysAngularRadius, float InThetaPixel)
{
	const float T1 = min(UNI_VOL_HANDOFF_PX * InThetaPixel, UNI_THETA_PROMOTE);
	const float X = saturate((InPhysAngularRadius - 0.5f * T1) / (0.5f * T1));
	return X * X * (3.0f - 2.0f * X);
}

/** Visibility of an object before the level fade: point fade from its apparent magnitude and,
 *  for extended sources, the resolved surface-brightness fade (D-121). Shared by the sprite
 *  and the volume carrier, which must agree on it (D-128). */
UNI_FN float Uni_ObjectVisibility(FUniObject InObj, float InDistance, float InPhysAngularRadius, FUniView InView)
{
	const float AppMag = Uni_ApparentMag(Uni_ObjectAbsMag(InObj), InDistance);
	const float PointFade = Uni_MagFade(AppMag, InView.LimitingMag);
	if ((Uni_ObjectFlags(InObj) & UNI_OBJ_FLAG_EXTENDED) == 0u) { return PointFade; }
	const float Resolve = saturate(InPhysAngularRadius / UNI_THETA_MIN - 1.0f);
	const float ExtFade = Uni_MagFade(Uni_ObjectSurfaceBrightness(InObj), InView.SurfaceLimit) * Resolve;
	return max(PointFade, ExtFade);
}

/** Pixel-shader scene-depth test: keep the sprite only if the scene surface along this ray is
 *  farther than the object's true distance. Both are true-scale distances (D-120). */
UNI_FN bool Uni_SceneDepthKeep(float InTrueDistance, float InSceneDistance)
{
	// InSceneDistance is the render-space distance read from scene depth (D-146).
	return InTrueDistance < Uni_SceneTrueDistance(InSceneDistance);
}

/** Project one object. Returns the sprite; Flags says whether it is visible and whether it is
 *  a promotion candidate (candidates are reported even when culled for being promoted). */
UNI_FN FUniSprite Uni_ProjectObject(uint4 InCellDeltaX, uint4 InCellDeltaY, uint4 InCellDeltaZ, uint InLevel,
	float InLevelFade, FUniObject InObj, FUniView InView, bool InWasPromoted)
{
	FUniSprite S;
	S.RenderPos = float3(0.0f, 0.0f, 0.0f);
	S.AngularRadius = 0.0f;
	S.Radiance = float3(0.0f, 0.0f, 0.0f);
	S.TrueDistance = 0.0f;
	S.NdcX = 0.0f;
	S.NdcY = 0.0f;
	S.Flags = 0u;
	S.PhysAngularRadius = 0.0f;
	S.HaloRadius = 0.0f;
	S.HaloRatio = 0.0f;
	S.Pad0 = 0.0f;
	S.Pad1 = 0.0f;

	const uint3 Off = uint3(InObj.A.x, InObj.A.y, InObj.A.z);
	const float3 Rel = Uni_ObjectRelative(InCellDeltaX, InCellDeltaY, InCellDeltaZ, Off, InLevel, InView.CameraFraction);
	const float R = max(Uni_SafeLength(Rel), 1.0e-3f);
	const float3 Dir = Rel * (1.0f / R);
	S.TrueDistance = R;

	const float Radius = exp2(Uni_ObjectRadiusLog2(InObj));
	S.PhysAngularRadius = Radius / R;
	const uint ObjFlags = Uni_ObjectFlags(InObj);
	if (Uni_PromoteTest(R, Radius, InWasPromoted)) { S.Flags = S.Flags | UNI_SPRITE_PROMOTE_CANDIDATE; }
	if ((ObjFlags & UNI_OBJ_FLAG_DELTA_HIDDEN) != 0u) { return S; }
	// D-158: a promoted point source (a star) keeps its glare: the actor replaces only the core,
	// so the point of light reads the same across the swap. Promoted extended objects (planets)
	// are drawn by their actor alone, as before.
	const bool bPromoted = (ObjFlags & UNI_OBJ_FLAG_PROMOTED) != 0u;
	if (bPromoted && (ObjFlags & UNI_OBJ_FLAG_EXTENDED) != 0u) { return S; }

	// Photometry. Every source has a point-source visibility from its apparent magnitude. An
	// extended source also has a resolved visibility from its surface brightness, which ramps
	// in from 0 at theta_min to full at 2 theta_min, so the switch to surface-brightness
	// photometry is continuous (no pop when a galaxy grows past theta_min, D-121).
	const float AbsMag = Uni_ObjectAbsMag(InObj);
	const float AppMag = Uni_ApparentMag(AbsMag, R);
	const float Fade = Uni_ObjectVisibility(InObj, R, S.PhysAngularRadius, InView);
	const bool bExtended = (ObjFlags & UNI_OBJ_FLAG_EXTENDED) != 0u && S.PhysAngularRadius > UNI_THETA_MIN;
	// An extended object with children hands its light to its volume carrier as it grows
	// (D-129), and every flux is horizon-dimmed (D-131). Both are render-only.
	const bool bCarrier = (ObjFlags & (UNI_OBJ_FLAG_EXTENDED | UNI_OBJ_FLAG_HAS_CONTRIBUTOR)) == (UNI_OBJ_FLAG_EXTENDED | UNI_OBJ_FLAG_HAS_CONTRIBUTOR);
	const float SpriteShare = bCarrier ? 1.0f - Uni_CarrierHandoff(S.PhysAngularRadius, InView.ThetaPixel) : 1.0f;
	const float Intensity = pow(10.0f, -0.4f * (AppMag - InView.ExposureMag)) * Fade * saturate(InLevelFade) * SpriteShare * Uni_HorizonDimming(R);
	if (!(Intensity > 0.0f)) { return S; }

	// Frustum.
	const float Fz = dot(Dir, InView.Forward);
	if (Fz <= 0.0f) { return S; }
	const float Nx = dot(Dir, InView.Right) / (Fz * InView.TanHalfFovX);
	const float Ny = dot(Dir, InView.Up) / (Fz * InView.TanHalfFovY);
	const float Margin = 1.0f + (S.PhysAngularRadius + InView.ThetaPixel) / InView.TanHalfFovX;
	if (abs(Nx) > Margin || abs(Ny) > Margin) { return S; }

	S.NdcX = Nx;
	S.NdcY = Ny;
	S.RenderPos = Dir * Uni_Compress(R);

	// D-156, revised by D-158 (owner: "a seamless experience at all distances: approach a star,
	// resolve its system and eventually its actor without any unexpected behaviour in the way the
	// point of light reads"). A sprite is a CORE plus, for a point source, a GLARE halo, and
	// neither ever shrinks on the way in:
	//  - Core: a Gaussian of sigma max(true angular radius, CorePx pixels): pegged at CorePx
	//    while unresolved, growing with the true size once that is larger. Its light is the
	//    intensity up to a saturation level; a resolved core saturates per area
	//    (Sat x (core / CorePx)^2), so its surface brightness holds as it grows.
	//  - Glare (point sources only: stars; not galaxies, clusters or planets): above
	//    saturation, energy HaloGain x Sat x (doublings over Sat) and sigma core x (1 + growth),
	//    the growth HaloGrowth pixels per doubling, capped at HaloMax / CorePx. While unresolved
	//    that is CorePx + HaloGrowth x doublings pixels, at most HaloMax; once resolved the whole
	//    sprite scales with the true size (the doublings over the area-scaled saturation stop
	//    changing), so the glare grows with the disc instead of being left behind.
	//  - Approach: brightness only rises, so core and glare only grow. There is no arrival ramp
	//    any more (D-150 is superseded). A promoted star keeps its glare (HALO_ONLY) and its actor
	//    draws the disc.
	//  - CoreSat <= 0: physical mode: all light in the core, no glare (the engine's bloom).
	const bool bBody = bExtended && (ObjFlags & UNI_OBJ_FLAG_HAS_CONTRIBUTOR) == 0u;
	const bool bPoint = (ObjFlags & UNI_OBJ_FLAG_EXTENDED) == 0u;
	const float CorePx = Uni_SpriteCorePx(InView);
	const float CoreMin = CorePx * InView.ThetaPixel;
	S.AngularRadius = max(S.PhysAngularRadius, CoreMin);
	S.HaloRadius = 0.0f;
	S.HaloRatio = 0.0f;
	float CoreE = Intensity;
	if (InView.CoreSat > 0.0f)
	{
		const float Area = S.AngularRadius / CoreMin;
		const float Sat = InView.CoreSat * Area * Area;
		CoreE = Uni_SpriteSaturate(Intensity, Sat);
		const float Over = bPoint ? max(log2(max(Intensity, 1.0e-30f) / Sat), 0.0f) : 0.0f;   // doublings over saturation
		const float HaloE = InView.HaloGain * Sat * Over;
		if (HaloE > 0.0f && CoreE > 0.0f)
		{
			const float Growth = min(max(InView.HaloMaxPx / CorePx - 1.0f, 0.0f), InView.HaloGrowthPx * Over / CorePx);
			S.HaloRadius = S.AngularRadius * (1.0f + Growth);
			S.HaloRatio = HaloE / CoreE;
		}
	}
	if (bPromoted && !(S.HaloRatio > 0.0f)) { return S; }   // a promoted star without glare: the actor alone
	const float3 Col = Uni_UnpackColour(InObj.B.w);
	S.Radiance = Col * (CoreE / max(Uni_Luminance(Col), 1.0e-3f));   // the core's light; luminance = core energy (D-135)
	S.Flags = S.Flags | UNI_SPRITE_VISIBLE | (bExtended ? UNI_SPRITE_EXTENDED : 0u) | (bBody ? UNI_SPRITE_BODY : 0u) | (bPromoted ? UNI_SPRITE_HALO_ONLY : 0u);
	return S;
}

/** D-148: the disc fraction of a sprite, DiscFrac = PhysAngularRadius / AngularRadius for a
 *  body wider than UNI_SPRITE_DISC_MIN_PX, else 0 (a plain Gaussian). */
UNI_FN float Uni_SpriteDiscFrac(FUniSprite InS, float InPixelsPerRadian)
{
	if ((InS.Flags & UNI_SPRITE_BODY) == 0u) { return 0.0f; }
	if (InS.PhysAngularRadius * InPixelsPerRadian < UNI_SPRITE_DISC_MIN_PX) { return 0.0f; }
	return saturate(InS.PhysAngularRadius / max(InS.AngularRadius, 1.0e-30f));
}

/** D-148: the sprite's per-pixel weight at RPx pixels from its centre, normalised so it sums to
 *  1 over the pixels (energy = Radiance at any size). SigmaPx: the Gaussian's sigma (the
 *  sprite's angular radius in pixels). DiscFrac 0: the Gaussian alone. Otherwise a soft-edged
 *  uniform disc of radius DiscFrac x SigmaPx carries DiscFrac of the energy and the Gaussian
 *  (the remaining glare halo) the rest, so at DiscFrac = 1 it is the body's disc exactly. */
UNI_FN float Uni_SpriteProfile(float InRPx, float InSigmaPx, float InDiscFrac)
{
	const float Gauss = exp(-0.5f * (InRPx * InRPx) / (InSigmaPx * InSigmaPx)) / (6.2831853f * InSigmaPx * InSigmaPx);
	if (!(InDiscFrac > 0.0f)) { return Gauss; }
	const float D = InDiscFrac * InSigmaPx;
	const float Disc = saturate(D + 0.5f - InRPx) / (3.14159265f * D * D + 0.2617994f);   // pi D^2 + pi/12: the 1 px soft edge's area
	return lerp(Gauss, Disc, InDiscFrac);
}

/** D-158: the core's share of the profile: 0 for a promoted star (its actor draws the disc). */
UNI_FN float Uni_SpriteCoreWeight(FUniSprite InS)
{
	return (InS.Flags & UNI_SPRITE_HALO_ONLY) != 0u ? 0.0f : 1.0f;
}

/** D-156: the angular radius the sprite's quad must cover: the halo's when it has one. */
UNI_FN float Uni_SpriteFootprint(FUniSprite InS)
{
	return InS.HaloRatio > 0.0f ? max(InS.AngularRadius, InS.HaloRadius) : InS.AngularRadius;
}

/** D-156: core (Uni_SpriteProfile, times CoreWeight: D-158) plus halo: a Gaussian of sigma
 *  HaloSigmaPx carrying HaloRatio x the core's energy. Sums to CoreWeight + HaloRatio over the
 *  pixels, so with Radiance the core's light the halo adds HaloRatio x Radiance. */
UNI_FN float Uni_SpriteProfileHalo(float InRPx, float InSigmaPx, float InDiscFrac, float InHaloSigmaPx, float InHaloRatio, float InCoreWeight)
{
	float W = InCoreWeight > 0.0f ? InCoreWeight * Uni_SpriteProfile(InRPx, InSigmaPx, InDiscFrac) : 0.0f;
	if (InHaloRatio > 0.0f && InHaloSigmaPx > 0.0f)
	{
		W += InHaloRatio * exp(-0.5f * (InRPx * InRPx) / (InHaloSigmaPx * InHaloSigmaPx)) / (6.2831853f * InHaloSigmaPx * InHaloSigmaPx);
	}
	return W;
}

#endif // UNI_PROJECT_USH
