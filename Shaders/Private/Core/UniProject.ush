// UniProject.ush
// Project and cull: one resident object -> one sprite (or nothing). Shared by the GPU pass
// (UniProject.usf, every frame, every resident object) and the CPU reference renderer.
//
//   1. Exact camera-relative vector: per-cell 128-bit delta + offset in integer, one float
//      conversion (D-104). r and direction from it, overflow-safe.
//   2. Apparent magnitude; surface brightness for resolved extended sources. Cull past the
//      limit, outside the frustum, promoted, or delta-hidden.
//   3. Render position p = d * f(r) and angular radius (unchanged by compression: scaling
//      about the eye preserves projection, so parallax is exact by construction).
//   4. Intensity in exposure-calibrated units (lesson #36), faded across the band and by the
//      level fade. Fades are render-only (lesson #12).
//   5. Promotion candidate test, with hysteresis: promote at r - R < r0 or R / r > theta_p,
//      demote at 1.25x both.

#ifndef UNI_PROJECT_USH
#define UNI_PROJECT_USH

#include "UniCoreDefs.ush"
#include "UniCoord.ush"
#include "UniPhotometry.ush"
#include "UniPlacement.ush"
#include "UniSystem.ush"

static const float UNI_THETA_PROMOTE = 0.02f;     // rad: angular size that promotes to an actor (D-119)
static const float UNI_PROMOTE_HYSTERESIS = 1.25f;

static const uint UNI_SPRITE_VISIBLE = 1u;
static const uint UNI_SPRITE_PROMOTE_CANDIDATE = 2u;
static const uint UNI_SPRITE_EXTENDED = 4u;
static const uint UNI_SPRITE_BODY = 8u;           // D-148: a resolved body (extended, no children): disc profile
static const uint UNI_SPRITE_HALO_ONLY = 16u;     // D-158: a promoted star: its actor draws the disc, the sprite keeps its glare
static const float UNI_SPRITE_DISC_MIN_PX = 1.5f; // below this a body is drawn as a plain Gaussian

// D-156 sprite style defaults (the owner tunes them live: uu.Sprite.*).
static const float UNI_SPRITE_CORE_PX = 1.0f;         // core sigma, px: an unresolved source is a pinpoint
static const float UNI_SPRITE_CORE_SAT = 16.0f;       // intensity (exposure units) where the core saturates: 3 mag over exposure
static const float UNI_SPRITE_HALO_GAIN = 0.25f;      // halo energy per doubling over saturation (x saturation)
static const float UNI_SPRITE_HALO_GROWTH_PX = 0.5f;  // halo sigma growth per doubling over saturation, px
static const float UNI_SPRITE_HALO_MAX_PX = 4.0f;     // halo sigma cap, px
// D-185: halo colour (render-only sprite style; uu.Sprite.HaloChroma). D-188: the sprite quad's
// reach (uu.Sprite.Floor).
static const float UNI_SPRITE_HALO_CHROMA = 1.4f;     // halo chroma x the star's (luminance kept)
static const float UNI_SPRITE_FLOOR = 2.0e-4f;        // scene colour (pre-exposed): a sprite's quad reaches until its profile falls below this
static const float UNI_SPRITE_REACH_MAX = 8.0f;       // the farthest reach, in Gaussian sigmas
// D-187: warp streaks and arrival (WARP_PLAN E1, E2; render-only; uu.Warp*).
static const uint UNI_SPRITE_ARRIVAL_SHIFT = 24u;     // FUniSprite::Flags bits 24..31: arrival 0..255 (255 settled)
static const uint UNI_CELL_AGE_SHIFT = 16u;           // FUniCellGPU::Flags bits 16..23: frames since the cell first became Ready (255: settled)

/** D-150: the distance at which an object's sprite must be back at its true perceived size.
 *  A star whose archetype has systems: its activation radius, where its planets spawn. Anything
 *  else: its promotion distance, where an actor replaces the sprite (R / theta_promote). */
UNI_FN float Uni_ArrivalDistance(uint InArchetypeId, uint InSystemArchetypeMask, float InAbsMag, float InRadius)
{
	const float Promote = InRadius / UNI_THETA_PROMOTE;
	if (InArchetypeId < 32u && ((InSystemArchetypeMask >> InArchetypeId) & 1u) != 0u)
	{
		return max(Uni_SystemActivationRadius(InAbsMag), Promote);
	}
	return Promote;
}

struct FUniView
{
	float3 Forward;
	float TanHalfFovX;
	float3 Right;
	float TanHalfFovY;
	float3 Up;
	float LimitingMag;        // m_lim = m_ref + dm
	float3 CameraFraction;    // sub-cm part of the camera position, [0, 1) cm
	float ExposureMag;        // magnitude that maps to intensity 1
	float SurfaceLimit;       // mu_lim = mu_ref + dm
	float ThetaPixel;         // angular radius of one pixel: minimum sprite footprint
	uint SystemArchetypeMask; // D-150: archetypes whose objects arrive at their system radius (UniSystem.ush)
	// D-156 sprite style: a pinpoint core plus a capped halo (Uni_SpriteDefaults sets these).
	float CorePx;             // core sigma for an unresolved source, pixels (<= 0: UNI_SPRITE_CORE_PX)
	float CoreSat;            // intensity at which the core saturates (<= 0: physical: no saturation, no halo)
	float HaloGain;           // halo energy per doubling of intensity over saturation, in units of saturation
	float HaloGrowthPx;       // halo sigma growth per doubling over saturation, pixels
	float HaloMaxPx;          // halo sigma cap for an unresolved source, pixels
	uint DiscArchetypeMask;   // D-183: archetypes (id < 32) whose objects are disc galaxies: their sprites are inclined ellipses
	uint4 FixedDiscSeeds;     // D-183: object seeds of anchors with a fixed (identity) orientation: disc normal world z (0: unused)
	float3 WarpVel;           // D-190: the camera's motion (unit; any when WarpBeta is 0)
	float WarpBeta;           // D-190: the effective speed of the warp optics (0: none)
	float WarpDoppler;        // D-190: Doppler colour strength (Uni_DopplerTint's InK)
	float WarpBeaming;        // D-190: beaming exponent (0: light kept)
	float WarpPad0;
	float WarpPad1;
};

struct FUniSprite
{
	float3 RenderPos;         // camera-relative, compressed: dir * f(r)
	float AngularRadius;      // rad, for the sprite quad (render size = AngularRadius * f(r))
	float3 Radiance;          // colour / luminance * intensity, exposure-calibrated (D-135)
	float TrueDistance;       // cm, for the scene-depth test
	float NdcX;               // [-1, 1] across the view
	float NdcY;
	uint Flags;
	float PhysAngularRadius;  // R / r, rad (promotion, volumetric hand-off)
	float HaloRadius;         // D-156: halo sigma, rad (0: no halo)
	float HaloRatio;          // D-156: halo energy / core energy (0: no halo)
	float EllipseAngle;       // D-183: a disc galaxy's minor axis in the quad's (Side, Up) basis, rad
	float EllipseAxis;        // D-183: its projected axis ratio (minor / major); 0: round
};

/** D-156: FUniView with the default sprite style. */
UNI_FN FUniView Uni_SpriteDefaults(FUniView InView)
{
	FUniView V = InView;
	V.CorePx = UNI_SPRITE_CORE_PX;
	V.CoreSat = UNI_SPRITE_CORE_SAT;
	V.HaloGain = UNI_SPRITE_HALO_GAIN;
	V.HaloGrowthPx = UNI_SPRITE_HALO_GROWTH_PX;
	V.HaloMaxPx = UNI_SPRITE_HALO_MAX_PX;
	return V;
}

UNI_FN float Uni_SpriteCorePx(FUniView InView)
{
	return InView.CorePx > 0.0f ? InView.CorePx : UNI_SPRITE_CORE_PX;
}

/** D-156: the core's energy for an intensity, saturating at Sat with a sharp knee:
 *  I / (1 + (I / Sat)^4)^(1/4): within 0.01% of I below Sat / 8, 0.84 Sat at Sat, Sat far above it. */
UNI_FN float Uni_SpriteSaturate(float InIntensity, float InSat)
{
	const float X = min(InIntensity / InSat, 1.0e4f);   // X^4 stays finite; past 1e4 the result is Sat to 1e-16
	const float X2 = X * X;
	return InSat * X * rsqrt(sqrt(1.0f + X2 * X2));
}

/** Promotion test with hysteresis. */
UNI_FN bool Uni_PromoteTest(float InDistance, float InRadius, bool InWasPromoted)
{
	const float H = InWasPromoted ? UNI_PROMOTE_HYSTERESIS : 1.0f;
	return (InDistance - InRadius < UNI_R0_CM * H) || (InRadius / InDistance > UNI_THETA_PROMOTE / H);
}

/** Volume handoff (D-129): weight of an extended object's light carried by its volume
 *  carrier instead of its sprite. A smoothstep in angular radius from Theta1 / 2 to Theta1,
 *  Theta1 = min(8 px, theta_promote), so the ramp always completes before the promotion
 *  threshold, at any resolution. The CPU carrier builder calls this same function. */
static const float UNI_VOL_HANDOFF_PX = 8.0f;

UNI_FN float Uni_CarrierHandoff(float InPhysAngularRadius, float InThetaPixel)
{
	const float T1 = min(UNI_VOL_HANDOFF_PX * InThetaPixel, UNI_THETA_PROMOTE);
	const float X = saturate((InPhysAngularRadius - 0.5f * T1) / (0.5f * T1));
	return X * X * (3.0f - 2.0f * X);
}

/** Visibility of an object before the level fade: point fade from its apparent magnitude and,
 *  for extended sources, the resolved surface-brightness fade (D-121). Shared by the sprite
 *  and the volume carrier, which must agree on it (D-128). */
UNI_FN float Uni_ObjectVisibility(FUniObject InObj, float InDistance, float InPhysAngularRadius, FUniView InView)
{
	const float AppMag = Uni_ApparentMag(Uni_ObjectAbsMag(InObj), InDistance);
	const float PointFade = Uni_MagFade(AppMag, InView.LimitingMag);
	if ((Uni_ObjectFlags(InObj) & UNI_OBJ_FLAG_EXTENDED) == 0u) { return PointFade; }
	const float Resolve = saturate(InPhysAngularRadius / UNI_THETA_MIN - 1.0f);
	const float ExtFade = Uni_MagFade(Uni_ObjectSurfaceBrightness(InObj), InView.SurfaceLimit) * Resolve;
	return max(PointFade, ExtFade);
}

/** Pixel-shader scene-depth test: keep the sprite only if the scene surface along this ray is
 *  farther than the object's true distance. Both are true-scale distances (D-120). */
UNI_FN bool Uni_SceneDepthKeep(float InTrueDistance, float InSceneDistance)
{
	// InSceneDistance is the render-space distance read from scene depth (D-146).
	return InTrueDistance < Uni_SceneTrueDistance(InSceneDistance);
}

/** D-183: the disc normal (world) of a galaxy from its object seed: the third row of
 *  UniGenRef's RandomRotation (rows map world to field; the disc is the field's xy plane), in
 *  float. Anchors with a fixed orientation (the Milky Way) take world z instead: their seeds
 *  are in FUniView::FixedDiscSeeds. */
UNI_FN float3 Uni_DiscNormal(uint InSeed)
{
	const float U1 = Uni_DrawUnit(InSeed, UNI_CH_ORIENT, 0u), U2 = Uni_DrawUnit(InSeed, UNI_CH_ORIENT, 1u), U3 = Uni_DrawUnit(InSeed, UNI_CH_ORIENT, 2u);
	const float A = sqrt(1.0f - U1), B = sqrt(U1);
	const float X = A * sin(6.2831853f * U2), Y = A * cos(6.2831853f * U2);
	const float Z = B * sin(6.2831853f * U3), W = B * cos(6.2831853f * U3);
	return float3(2.0f * (X * Z - Y * W), 2.0f * (Y * Z + X * W), 1.0f - 2.0f * (X * X + Y * Y));
}

/** D-183: the effective axis ratio of a sprite's ellipse at SigmaPx pixels of core sigma: never
 *  thinner than ~0.7 px along the minor axis, so small sprites stay round (orientation shows
 *  only once a galaxy is a few pixels across) and the Gaussian is never undersampled. */
UNI_FN float Uni_SpriteEllipseQ(FUniSprite InS, float InSigmaPx)
{
	if (!(InS.EllipseAxis > 0.0f)) { return 1.0f; }
	return clamp(max(InS.EllipseAxis, 0.7f / max(InSigmaPx, 1.0e-3f)), 0.0f, 1.0f);
}

/** D-183: the radius (pixels) at which to evaluate the round profile for a pixel at offset
 *  (InX, InY) pixels in the quad's (Side, Up) basis: squashed along the minor axis. The profile
 *  is then divided by Q, so the energy is unchanged. */
UNI_FN float Uni_SpriteEllipseR(float InX, float InY, float InAngle, float InQ)
{
	const float Ca = cos(InAngle), Sa = sin(InAngle);
	const float V = InX * Ca + InY * Sa;      // along the minor axis
	const float U = -InX * Sa + InY * Ca;     // along the major axis
	return sqrt(U * U + (V / InQ) * (V / InQ));
}

/** D-196: true when an object can hand light to a volume carrier (an extended object with
 *  children): its sprite share then comes from the frame's carrier handoffs. */
UNI_FN bool Uni_ObjectIsCarrierParent(FUniObject InObj)
{
	const uint F = Uni_ObjectFlags(InObj);
	return (F & (UNI_OBJ_FLAG_EXTENDED | UNI_OBJ_FLAG_HAS_CONTRIBUTOR)) == (UNI_OBJ_FLAG_EXTENDED | UNI_OBJ_FLAG_HAS_CONTRIBUTOR);
}

/** Project one object. Returns the sprite; Flags says whether it is visible and whether it is
 *  a promotion candidate (candidates are reported even when culled for being promoted).
 *  InCarrierShare (D-196): the share of the object's light its volume carrier draws this frame
 *  (the volume builder's handoff, 0 when it has no carrier); negative: the handoff curve
 *  (Uni_CarrierHandoff), as before D-196 (offline checks of the sprites alone). */
/** D-204: from the cell's context (Uni_CellRel, built once per cell). */
UNI_FN FUniSprite Uni_ProjectObjectC(FUniCellRel InCell,
	float InLevelFade, FUniObject InObj, FUniView InView, bool InWasPromoted, float InCarrierShare)
{
	FUniSprite S;
	S.RenderPos = float3(0.0f, 0.0f, 0.0f);
	S.AngularRadius = 0.0f;
	S.Radiance = float3(0.0f, 0.0f, 0.0f);
	S.TrueDistance = 0.0f;
	S.NdcX = 0.0f;
	S.NdcY = 0.0f;
	S.Flags = 0u;
	S.PhysAngularRadius = 0.0f;
	S.HaloRadius = 0.0f;
	S.HaloRatio = 0.0f;
	S.EllipseAngle = 0.0f;
	S.EllipseAxis = 0.0f;

	const uint3 Off = uint3(InObj.A.x, InObj.A.y, InObj.A.z);
	const float3 Rel = Uni_ObjectRelativeC(InCell, Off, InView.CameraFraction);   // D-204
	const float R = max(Uni_SafeLength(Rel), 1.0e-3f);
	// D-190: at warp the source is seen at its aberrated direction, in its Doppler-shifted colour.
	const float3 TrueDir = Rel * (1.0f / R);
	const float Dop = Uni_DopplerFactor(TrueDir, InView.WarpVel, InView.WarpBeta);
	const float3 Dir = Uni_Aberrate(TrueDir, InView.WarpVel, InView.WarpBeta);
	S.TrueDistance = R;

	const float Radius = exp2(Uni_ObjectRadiusLog2(InObj));
	S.PhysAngularRadius = Radius / R;
	const uint ObjFlags = Uni_ObjectFlags(InObj);
	if (Uni_PromoteTest(R, Radius, InWasPromoted)) { S.Flags = S.Flags | UNI_SPRITE_PROMOTE_CANDIDATE; }
	if ((ObjFlags & UNI_OBJ_FLAG_DELTA_HIDDEN) != 0u) { return S; }
	// D-158: a promoted point source (a star) keeps its glare: the actor replaces only the core,
	// so the point of light reads the same across the swap. Promoted extended objects (planets)
	// are drawn by their actor alone, as before.
	const bool bPromoted = (ObjFlags & UNI_OBJ_FLAG_PROMOTED) != 0u;
	if (bPromoted && (ObjFlags & UNI_OBJ_FLAG_EXTENDED) != 0u) { return S; }

	// Photometry. Every source has a point-source visibility from its apparent magnitude. An
	// extended source also has a resolved visibility from its surface brightness, which ramps
	// in from 0 at theta_min to full at 2 theta_min, so the switch to surface-brightness
	// photometry is continuous (no pop when a galaxy grows past theta_min, D-121).
	const float AbsMag = Uni_ObjectAbsMag(InObj);
	const float AppMag = Uni_ApparentMag(AbsMag, R);
	const float Fade = Uni_ObjectVisibility(InObj, R, S.PhysAngularRadius, InView);
	const bool bExtended = (ObjFlags & UNI_OBJ_FLAG_EXTENDED) != 0u && S.PhysAngularRadius > UNI_THETA_MIN;
	// An extended object with children hands its light to its volume carrier as it grows
	// (D-129), and every flux is horizon-dimmed (D-131). Both are render-only.
	const bool bCarrier = (ObjFlags & (UNI_OBJ_FLAG_EXTENDED | UNI_OBJ_FLAG_HAS_CONTRIBUTOR)) == (UNI_OBJ_FLAG_EXTENDED | UNI_OBJ_FLAG_HAS_CONTRIBUTOR);
	// D-196: the sprite keeps what the carrier did not take this frame. Before, it handed off by
	// the curve alone, so a galaxy left without a carrier (over the frame's carrier cap in a
	// cluster, its integral not ready, its contributor asleep) faded before its glow came in.
	const float Hand = InCarrierShare >= 0.0f ? saturate(InCarrierShare) : Uni_CarrierHandoff(S.PhysAngularRadius, InView.ThetaPixel);
	const float SpriteShare = bCarrier ? 1.0f - Hand : 1.0f;
	const float Intensity = pow(10.0f, -0.4f * (AppMag - InView.ExposureMag)) * Fade * saturate(InLevelFade) * SpriteShare * Uni_HorizonDimming(R);
	if (!(Intensity > 0.0f)) { return S; }

	// Frustum.
	const float Fz = dot(Dir, InView.Forward);
	if (Fz <= 0.0f) { return S; }
	const float Nx = dot(Dir, InView.Right) / (Fz * InView.TanHalfFovX);
	const float Ny = dot(Dir, InView.Up) / (Fz * InView.TanHalfFovY);
	const float Margin = 1.0f + (S.PhysAngularRadius + InView.ThetaPixel) / InView.TanHalfFovX;
	if (abs(Nx) > Margin || abs(Ny) > Margin) { return S; }

	S.NdcX = Nx;
	S.NdcY = Ny;
	S.RenderPos = Dir * Uni_Compress(R);

	// D-156, revised by D-158 (owner: "a seamless experience at all distances: approach a star,
	// resolve its system and eventually its actor without any unexpected behaviour in the way the
	// point of light reads"). A sprite is a CORE plus, for a point source, a GLARE halo, and
	// neither ever shrinks on the way in:
	//  - Core: a Gaussian of sigma max(true angular radius, CorePx pixels): pegged at CorePx
	//    while unresolved, growing with the true size once that is larger. Its light is the
	//    intensity up to a saturation level; a resolved core saturates per area
	//    (Sat x (core / CorePx)^2), so its surface brightness holds as it grows.
	//  - Glare (point sources only: stars; not galaxies, clusters or planets): above
	//    saturation, energy HaloGain x Sat x (doublings over Sat) and sigma core x (1 + growth),
	//    the growth HaloGrowth pixels per doubling, capped at HaloMax / CorePx. While unresolved
	//    that is CorePx + HaloGrowth x doublings pixels, at most HaloMax; once resolved the whole
	//    sprite scales with the true size (the doublings over the area-scaled saturation stop
	//    changing), so the glare grows with the disc instead of being left behind.
	//  - Approach: brightness only rises, so core and glare only grow. There is no arrival ramp
	//    any more (D-150 is superseded). A promoted star keeps its glare (HALO_ONLY) and its actor
	//    draws the disc.
	//  - CoreSat <= 0: physical mode: all light in the core, no glare (the engine's bloom).
	const bool bBody = bExtended && (ObjFlags & UNI_OBJ_FLAG_HAS_CONTRIBUTOR) == 0u;
	const bool bPoint = (ObjFlags & UNI_OBJ_FLAG_EXTENDED) == 0u;
	const float CorePx = Uni_SpriteCorePx(InView);
	const float CoreMin = CorePx * InView.ThetaPixel;
	S.AngularRadius = max(S.PhysAngularRadius, CoreMin);
	S.HaloRadius = 0.0f;
	S.HaloRatio = 0.0f;
	float CoreE = Intensity;
	if (InView.CoreSat > 0.0f)
	{
		const float Area = S.AngularRadius / CoreMin;
		const float Sat = InView.CoreSat * Area * Area;
		CoreE = Uni_SpriteSaturate(Intensity, Sat);
		const float Over = bPoint ? max(log2(max(Intensity, 1.0e-30f) / Sat), 0.0f) : 0.0f;   // doublings over saturation
		const float HaloE = InView.HaloGain * Sat * Over;
		if (HaloE > 0.0f && CoreE > 0.0f)
		{
			const float Growth = min(max(InView.HaloMaxPx / CorePx - 1.0f, 0.0f), InView.HaloGrowthPx * Over / CorePx);
			S.HaloRadius = S.AngularRadius * (1.0f + Growth);
			S.HaloRatio = HaloE / CoreE;
		}
	}
	if (bPromoted && !(S.HaloRatio > 0.0f)) { return S; }   // a promoted star without glare: the actor alone
	const float3 Col = Uni_UnpackColour(InObj.B.w);
	S.Radiance = Col * (CoreE / max(Uni_Luminance(Col), 1.0e-3f));   // the core's light; luminance = core energy (D-135)
	S.Flags = S.Flags | UNI_SPRITE_VISIBLE | (bExtended ? UNI_SPRITE_EXTENDED : 0u) | (bBody ? UNI_SPRITE_BODY : 0u) | (bPromoted ? UNI_SPRITE_HALO_ONLY : 0u);
	if (InView.WarpBeta != 0.0f) { S.Radiance = Uni_DopplerTint(S.Radiance, Dop, InView.WarpDoppler, InView.WarpBeaming); }   // D-190
	// D-183: a disc galaxy reads as an ellipse at its inclination: the disc normal is its
	// contributor's (the object seed's random rotation, UniGenRef RandomRotation), the axis ratio
	// sqrt(cos^2 i + q0^2 sin^2 i) (q0 0.2 for a disc, 0.65 for an early type: the rolled fields'
	// light-weighted thickness, 0.11-0.31 for discs, D-183), the minor axis
	// along the normal's projection. Expressed in the quad's basis, as the vertex shader builds it.
	const uint DiscArch = Uni_ObjectArchetype(InObj);
	if (bExtended && DiscArch < 32u && ((InView.DiscArchetypeMask >> DiscArch) & 1u) != 0u)
	{
		const uint Sd = InObj.B.x;
		const bool bFixed = Sd != 0u && (InView.FixedDiscSeeds.x == Sd || InView.FixedDiscSeeds.y == Sd || InView.FixedDiscSeeds.z == Sd || InView.FixedDiscSeeds.w == Sd);
		const float3 N = bFixed ? float3(0.0f, 0.0f, 1.0f) : Uni_DiscNormal(Sd);
		const float Ci = dot(N, Dir);
		const float Q0 = (ObjFlags & UNI_OBJ_FLAG_EARLY) != 0u ? 0.65f : 0.2f;
		S.EllipseAxis = sqrt(saturate(Ci * Ci + Q0 * Q0 * (1.0f - Ci * Ci)));
		const float3 Side = normalize(cross(Dir, InView.Up + InView.Right * 1.0e-3f));
		const float3 Up = cross(Side, Dir);
		const float3 Np = N - Dir * Ci;
		S.EllipseAngle = atan2(dot(Np, Up), dot(Np, Side));
	}
	return S;
}

UNI_FN FUniSprite Uni_ProjectObjectH(uint4 InCellDeltaX, uint4 InCellDeltaY, uint4 InCellDeltaZ, uint InLevel,
	float InLevelFade, FUniObject InObj, FUniView InView, bool InWasPromoted, float InCarrierShare)
{
	return Uni_ProjectObjectC(Uni_CellRel(InCellDeltaX, InCellDeltaY, InCellDeltaZ, InLevel), InLevelFade, InObj, InView, InWasPromoted, InCarrierShare);
}

/** Project one object with the handoff curve (the sprites alone, offline). */
UNI_FN FUniSprite Uni_ProjectObject(uint4 InCellDeltaX, uint4 InCellDeltaY, uint4 InCellDeltaZ, uint InLevel,
	float InLevelFade, FUniObject InObj, FUniView InView, bool InWasPromoted)
{
	return Uni_ProjectObjectH(InCellDeltaX, InCellDeltaY, InCellDeltaZ, InLevel, InLevelFade, InObj, InView, InWasPromoted, -1.0f);
}

/** D-148: the disc fraction of a sprite, DiscFrac = PhysAngularRadius / AngularRadius for a
 *  body wider than UNI_SPRITE_DISC_MIN_PX, else 0 (a plain Gaussian). */
UNI_FN float Uni_SpriteDiscFrac(FUniSprite InS, float InPixelsPerRadian)
{
	if ((InS.Flags & UNI_SPRITE_BODY) == 0u) { return 0.0f; }
	if (InS.PhysAngularRadius * InPixelsPerRadian < UNI_SPRITE_DISC_MIN_PX) { return 0.0f; }
	return saturate(InS.PhysAngularRadius / max(InS.AngularRadius, 1.0e-30f));
}

/** D-148: the sprite's per-pixel weight at RPx pixels from its centre, normalised so it sums to
 *  1 over the pixels (energy = Radiance at any size). SigmaPx: the Gaussian's sigma (the
 *  sprite's angular radius in pixels). DiscFrac 0: the Gaussian alone. Otherwise a soft-edged
 *  uniform disc of radius DiscFrac x SigmaPx carries DiscFrac of the energy and the Gaussian
 *  (the remaining glare halo) the rest, so at DiscFrac = 1 it is the body's disc exactly. */
UNI_FN float Uni_SpriteProfile(float InRPx, float InSigmaPx, float InDiscFrac)
{
	const float Gauss = exp(-0.5f * (InRPx * InRPx) / (InSigmaPx * InSigmaPx)) / (6.2831853f * InSigmaPx * InSigmaPx);
	if (!(InDiscFrac > 0.0f)) { return Gauss; }
	const float D = InDiscFrac * InSigmaPx;
	const float Disc = saturate(D + 0.5f - InRPx) / (3.14159265f * D * D + 0.2617994f);   // pi D^2 + pi/12: the 1 px soft edge's area
	return lerp(Gauss, Disc, InDiscFrac);
}

/** D-158: the core's share of the profile: 0 for a promoted star (its actor draws the disc). */
UNI_FN float Uni_SpriteCoreWeight(FUniSprite InS)
{
	return (InS.Flags & UNI_SPRITE_HALO_ONLY) != 0u ? 0.0f : 1.0f;
}

/** D-156: the angular radius the sprite's quad must cover: the halo's when it has one. */
UNI_FN float Uni_SpriteFootprint(FUniSprite InS)
{
	return InS.HaloRatio > 0.0f ? max(InS.AngularRadius, InS.HaloRadius) : InS.AngularRadius;
}

/** D-156: core (Uni_SpriteProfile, times CoreWeight: D-158) plus halo: a Gaussian of sigma
 *  HaloSigmaPx carrying HaloRatio x the core's energy. Sums to CoreWeight + HaloRatio over the
 *  pixels, so with Radiance the core's light the halo adds HaloRatio x Radiance. */
UNI_FN float Uni_SpriteProfileHalo(float InRPx, float InSigmaPx, float InDiscFrac, float InHaloSigmaPx, float InHaloRatio, float InCoreWeight)
{
	float W = InCoreWeight > 0.0f ? InCoreWeight * Uni_SpriteProfile(InRPx, InSigmaPx, InDiscFrac) : 0.0f;
	if (InHaloRatio > 0.0f && InHaloSigmaPx > 0.0f)
	{
		W += InHaloRatio * exp(-0.5f * (InRPx * InRPx) / (InHaloSigmaPx * InHaloSigmaPx)) / (6.2831853f * InHaloSigmaPx * InHaloSigmaPx);
	}
	return W;
}

/** D-183: Uni_SpriteProfileHalo for a sprite whose core is an ellipse: the pixel at (InX, InY)
 *  pixels in the quad's (Side, Up) basis. The core is the round profile at the squashed radius
 *  divided by Q (its energy unchanged: the area shrinks by Q); the D-156 halo is optical glare
 *  and stays round. Q = 1 is Uni_SpriteProfileHalo exactly. */
UNI_FN float Uni_SpriteProfileEllipse(float InX, float InY, float InSigmaPx, float InDiscFrac, float InHaloSigmaPx, float InHaloRatio, float InCoreWeight, float InAngle, float InQ)
{
	const float R = sqrt(InX * InX + InY * InY);
	if (!(InQ < 1.0f)) { return Uni_SpriteProfileHalo(R, InSigmaPx, InDiscFrac, InHaloSigmaPx, InHaloRatio, InCoreWeight); }
	float W = InCoreWeight > 0.0f ? InCoreWeight * Uni_SpriteProfile(Uni_SpriteEllipseR(InX, InY, InAngle, InQ), InSigmaPx, InDiscFrac) / InQ : 0.0f;
	return W + Uni_SpriteProfileHalo(R, InSigmaPx, InDiscFrac, InHaloSigmaPx, InHaloRatio, 0.0f);
}

/** D-185: a colour with its chroma scaled about its luminance, luminance kept (the halo: more
 *  vibrant than the core, which reads white once it saturates). */
UNI_FN float3 Uni_SpriteChroma(float3 InC, float InK)
{
	const float Y = Uni_Luminance(InC);
	if (!(Y > 0.0f)) { return InC; }
	const float3 C = max(float3(Y, Y, Y) + (InC - float3(Y, Y, Y)) * InK, float3(0.0f, 0.0f, 0.0f));
	const float Yc = Uni_Luminance(C);
	return Yc > 0.0f ? C * (Y / Yc) : InC;
}

/** D-188: how many sigmas a Gaussian of peak InPeak (per pixel) needs before it falls below
 *  InFloor: at least InMinSigmas (the quad's old fixed 3), at most UNI_SPRITE_REACH_MAX. */
UNI_FN float Uni_GaussReachSigmas(float InPeak, float InFloor, float InMinSigmas)
{
	const float K = sqrt(2.0f * log(max(InPeak / max(InFloor, 1.0e-30f), 1.0f)));
	return clamp(K, InMinSigmas, max(UNI_SPRITE_REACH_MAX, InMinSigmas));
}

/** D-188: the radius (pixels) a sprite's quad must cover so that nothing it draws is cut: the
 *  core and the halo each out to where they fall below InFloor (InLum: the sprite's luminance in
 *  the units of InFloor), a resolved disc (D-148) past its soft edge. Before, the quad was a fixed
 *  3 sigmas, and a very bright halo was still well above black there: a square cut. */
UNI_FN float Uni_SpriteReachPx(float InLum, float InSigmaPx, float InDiscFrac, float InHaloPx, float InHaloRatio, float InCoreWeight, float InFloor, float InMinSigmas)
{
	// Each part to half the floor, so core and halo together stay under it.
	const float Fl = (InHaloRatio > 0.0f && InHaloPx > 0.0f) ? 0.5f * InFloor : InFloor;
	const float CorePeak = InCoreWeight * InLum / (6.2831853f * InSigmaPx * InSigmaPx);
	float R = InSigmaPx * Uni_GaussReachSigmas(CorePeak, Fl, InMinSigmas);
	if (InDiscFrac > 0.0f) { R = max(R, InDiscFrac * InSigmaPx + 1.5f); }
	if (InHaloRatio > 0.0f && InHaloPx > 0.0f)
	{
		const float HaloPeak = InHaloRatio * InLum / (6.2831853f * InHaloPx * InHaloPx);
		R = max(R, InHaloPx * Uni_GaussReachSigmas(HaloPeak, Fl, InMinSigmas));
	}
	return R;
}

/** D-188: a soft edge over the quad's last tenth, so a profile cut at the reach cap still never
 *  shows a hard square (below the cap the profile is already under the floor there). */
UNI_FN float Uni_SpriteEdgeWindow(float InRPx, float InReachPx)
{
	return 1.0f - smoothstep(0.9f * InReachPx, InReachPx, InRPx);
}

/** D-187: erf, Abramowitz and Stegun 7.1.26 (|error| < 1.5e-7), the same on CPU and GPU. */
UNI_FN float Uni_Erf(float InX)
{
	const float X = abs(InX);
	const float T = 1.0f / (1.0f + 0.3275911f * X);
	const float P = T * (0.254829592f + T * (-0.284496736f + T * (1.421413741f + T * (-1.453152027f + T * 1.061405429f))));
	const float E = 1.0f - P * exp(-X * X);
	return InX < 0.0f ? -E : E;
}

/** D-187: a normalised Gaussian of sigma InSigma smeared evenly along a segment from the
 *  centre to InL pixels along (InAx, InAy) (a unit vector in the quad's basis): the light a
 *  point leaves on the sensor while it moves through one frame's exposure. It sums to 1 over
 *  the pixels at any length; InL -> 0 is the plain Gaussian. */
UNI_FN float Uni_SpriteStreakGauss(float InX, float InY, float InSigma, float InAx, float InAy, float InL)
{
	const float S = max(InSigma, 1.0e-3f);
	const float U = InX * InAx + InY * InAy;     // along the tail
	const float V = -InX * InAy + InY * InAx;    // across
	const float Across = exp(-0.5f * V * V / (S * S)) / (2.5066283f * S);
	if (InL < 0.05f * S)
	{
		// Below this the difference of erfs cancels in float: the Gaussian at the tail's
		// midpoint (exact to second order in InL / InSigma, ~1e-4 here).
		const float Um = U - 0.5f * InL;
		return Across * exp(-0.5f * Um * Um / (S * S)) / (2.5066283f * S);
	}
	const float K = 0.70710678f / S;
	return Across * 0.5f * (Uni_Erf(U * K) - Uni_Erf((U - InL) * K)) / InL;
}

/** D-187: the core and halo of a point-source sprite as a streak (Uni_SpriteProfileHalo
 *  smeared over the tail; sums to CoreWeight + HaloRatio). */
UNI_FN float Uni_SpriteProfileStreak(float InX, float InY, float InSigmaPx, float InHaloSigmaPx, float InHaloRatio, float InCoreWeight, float InAx, float InAy, float InL)
{
	float W = InCoreWeight > 0.0f ? InCoreWeight * Uni_SpriteStreakGauss(InX, InY, InSigmaPx, InAx, InAy, InL) : 0.0f;
	if (InHaloRatio > 0.0f && InHaloSigmaPx > 0.0f) { W += InHaloRatio * Uni_SpriteStreakGauss(InX, InY, InHaloSigmaPx, InAx, InAy, InL); }
	return W;
}

/** D-187: a sprite's settled share from its cell's age: 0 on the frame its cell first became
 *  Ready, 1 after InFrames frames. */
UNI_FN float Uni_SpriteArrival(uint InAgeFrames, float InFrames)
{
	return InFrames > 0.0f ? saturate((float)InAgeFrames / InFrames) : 1.0f;
}

/** D-187: a sprite's streak over the last frame, from the camera's move alone (turning does not
 *  streak, so the view stays readable while steering): the object is static, so a frame ago it
 *  was along normalize(Dir x TrueDistance + CamStep). Returns the tail's direction in the quad's
 *  (Side, Up) basis and its length in pixels (z; 0: no streak). InWarp: (warp amount 0..1,
 *  exposure in frames, longest streak px, arrival stretch); an arriving sprite (InArrival < 1)
 *  streams in with its tail stretched by 1 + stretch x (1 - arrival). InAberr: the warp optics
 *  (D-190: motion xyz, effective speed w; w 0 none). */
UNI_FN float3 Uni_SpriteStreak(float3 InDir, float InTrueDistance, float3 InCamStep, float3 InSide, float3 InUp, float InPixelsPerRadian, float4 InWarp, float InArrival, float4 InAberr)
{
	if (!(InWarp.x > 0.0f) || !(InWarp.y > 0.0f)) { return float3(0.0f, 0.0f, 0.0f); }
	// Divided through by the distance first: |Dir x distance|^2 overflows a float past ~1e19 cm.
	// D-190: with the warp optics on, InDir is apparent: the motion is the true one, re-aberrated.
	float3 Prev;
	if (InAberr.w != 0.0f)
	{
		const float3 Vel = float3(InAberr.x, InAberr.y, InAberr.z);
		const float3 True = Uni_Aberrate(InDir, Vel, -InAberr.w);
		Prev = Uni_Aberrate(normalize(True + InCamStep * (1.0f / max(InTrueDistance, 1.0f))), Vel, InAberr.w);
	}
	else
	{
		Prev = normalize(InDir + InCamStep * (1.0f / max(InTrueDistance, 1.0f)));
	}
	const float3 T = Prev - InDir;
	const float Tx = dot(T, InSide), Ty = dot(T, InUp);
	const float Len = sqrt(Tx * Tx + Ty * Ty);
	if (!(Len > 0.0f)) { return float3(0.0f, 0.0f, 0.0f); }
	const float Stretch = 1.0f + InWarp.w * (1.0f - saturate(InArrival));
	const float L = min(Len * InPixelsPerRadian * InWarp.y * InWarp.x * Stretch, max(InWarp.z, 0.0f));
	if (L < 0.25f) { return float3(0.0f, 0.0f, 0.0f); }
	return float3(Tx / Len, Ty / Len, L);
}

/** D-192: warp ambience. Motes are decoration in empty space (nothing generated, render-only):
 *  points fixed in the world, UNI_MOTE_PER_CELL hashed into every cell of a cubic lattice, on two
 *  lattice levels whose scale follows the speed, so the nearest stream past within a second and
 *  streak like the stars (E1). Each level is 4 x 4 x 4 cells around the camera's (UNI_MOTE_COUNT
 *  sprites in all; about 20 in a 90 degree view); a mote fades out from 0.75 to 1.5 cells away, so
 *  the 4-cell block (shifted by the camera's half-cell) never shows its edge, and fades in near
 *  the camera from 0.35 to 0.1 cells (no one-frame flashes). The engine
 *  (UniMotes.h) gives per level: the camera's cell (low 32 bits per axis; w the level) and its
 *  fraction in it (w the level's weight: the warp amount x the scale's cross-fade), and the cell
 *  size (cm). InScale: (cell cm level 0, level 1, mote flux in exposure units, core angular
 *  radius). Doppler and aberration as the project pass's (InDopplerKQ: strength, beaming). */
static const uint UNI_MOTE_PER_CELL = 16u;
static const uint UNI_MOTE_COUNT = 2u * 64u * UNI_MOTE_PER_CELL;

UNI_FN FUniSprite Uni_MoteSprite(uint InIndex, uint4 InCell0, float4 InFrac0, uint4 InCell1, float4 InFrac1, float4 InScale, float3 InForward, float4 InVelBeta, float2 InDopplerKQ)
{
	FUniSprite S;
	S.RenderPos = float3(0.0f, 0.0f, 0.0f);
	S.AngularRadius = 0.0f;
	S.Radiance = float3(0.0f, 0.0f, 0.0f);
	S.TrueDistance = 0.0f;
	S.NdcX = 0.0f;
	S.NdcY = 0.0f;
	S.Flags = 0u;
	S.PhysAngularRadius = 0.0f;
	S.HaloRadius = 0.0f;
	S.HaloRatio = 0.0f;
	S.EllipseAngle = 0.0f;
	S.EllipseAxis = 0.0f;
	if (InIndex >= UNI_MOTE_COUNT) { return S; }
	const bool bSlot1 = InIndex >= (UNI_MOTE_COUNT / 2u);
	const uint4 Cell = bSlot1 ? InCell1 : InCell0;
	const float4 Fr = bSlot1 ? InFrac1 : InFrac0;
	const float CellCm = bSlot1 ? InScale.y : InScale.x;
	if (!(Fr.w > 0.0f) || !(CellCm > 0.0f)) { return S; }
	const uint J = (InIndex / UNI_MOTE_PER_CELL) & 63u;   // the cell in the 4 x 4 x 4 block
	const uint Km = InIndex % UNI_MOTE_PER_CELL;          // the mote in the cell
	// Cells -2..1 or -1..2 on each axis, whichever centres the camera (its half of its cell).
	const int Dx = (int)(J & 3u) + (Fr.x < 0.5f ? -2 : -1);
	const int Dy = (int)((J >> 2u) & 3u) + (Fr.y < 0.5f ? -2 : -1);
	const int Dz = (int)(J >> 4u) + (Fr.z < 0.5f ? -2 : -1);
	const uint Seed = Uni_SeedMix(Uni_SeedMix(Uni_SeedMix(Uni_SeedMix(Uni_SeedMix(UNI_CH_MOTE, Cell.w), Cell.x + (uint)Dx), Cell.y + (uint)Dy), Cell.z + (uint)Dz), Km);
	const float3 Hp = float3(Uni_DrawUnit(Seed, UNI_CH_MOTE, 1u), Uni_DrawUnit(Seed, UNI_CH_MOTE, 2u), Uni_DrawUnit(Seed, UNI_CH_MOTE, 3u));
	const float3 Cells = float3((float)Dx + Hp.x - Fr.x, (float)Dy + Hp.y - Fr.y, (float)Dz + Hp.z - Fr.z);
	const float Rc = Uni_SafeLength(Cells);
	const float Fade = Fr.w * (1.0f - smoothstep(0.75f, 1.5f, Rc)) * smoothstep(0.1f, 0.35f, Rc);
	if (!(Fade > 0.0f)) { return S; }
	const float3 TrueDir = Cells * (1.0f / Rc);
	const float3 Vel = float3(InVelBeta.x, InVelBeta.y, InVelBeta.z);
	const float3 Dir = Uni_Aberrate(TrueDir, Vel, InVelBeta.w);
	if (!(dot(Dir, InForward) > 0.0f)) { return S; }
	const float R = Rc * CellCm;
	const float I = InScale.z * Fade * pow(10.0f, -0.8f * Uni_DrawUnit(Seed, UNI_CH_MOTE, 4u));   // two magnitudes of spread
	S.TrueDistance = R;
	S.RenderPos = Dir * Uni_Compress(R);
	S.AngularRadius = InScale.w;
	S.PhysAngularRadius = 0.0f;
	S.Radiance = float3(I, I, I);
	if (InVelBeta.w != 0.0f) { S.Radiance = Uni_DopplerTint(S.Radiance, Uni_DopplerFactor(TrueDir, Vel, InVelBeta.w), InDopplerKQ.x, InDopplerKQ.y); }
	S.Flags = UNI_SPRITE_VISIBLE;
	return S;
}

#endif // UNI_PROJECT_USH
