// UniCompact.ush
// D-272 (Docs/COMPACT_OBJECTS.md, phase A; owner 2026-11-17: "probably do supermassives first since
// every spiral galaxy will have one, and placement is always in the center of the bulge... the
// implementation should be robust enough to use for stellar or supermassive"): black holes.
//
// Two layers, so the same code serves a galaxy's supermassive black hole now and a stellar black
// hole (or an X-ray binary's) later:
//   1. A black hole of any mass: FUniBlackHole from its mass and its accretion rate as a share of
//      the Eddington rate (Uni_BlackHoleOf): its bolometric luminosity, the V magnitude of its
//      accretion light, its Schwarzschild radius (the lensing pass, phase D), its colour.
//   2. A galaxy's supermassive black hole, a property of the galaxy record alone (no new records:
//      the project pass and the CPU read it from the same function): its mass from the host's
//      bulge (Haring & Rix 2004: 0.0014 x the bulge's mass, 0.3 dex scatter), the bulge from the
//      host's V luminosity, a bulge share and a mass-to-light ratio by type; its Eddington ratio
//      from a mixture: an accreting share of galaxies (p(log lambda) ~ lambda^-0.65 over 1e-4..1,
//      Aird et al. 2012) and a quiet rest (1e-9..1e-5, log-uniform: Sgr A* to M87). New seed
//      channels BH.MASS and BH.EDDINGTON (never reused): nothing else in the galaxy changes.
//
// The nucleus (Uni_NucleusAbsMag) is that black hole's accretion light as the galaxy shows it: an
// unresolved point at the bulge's centre (UniProject.ush, Uni_ProjectNucleusC), at most InCap x
// the host's light (0.5: the galaxy's level comes from the host's magnitude alone, and a brighter
// nucleus would outgrow its level's window), x an art gain (1: physical). Render only.
//
// D-273 (phase D; owner 2026-11-17: "Gravitational sensing ans accretion discs, there are quite a
// few shader references online for black holes as well"): the near field, for a black hole of any
// mass (everything below is in units of its Schwarzschild radius R_s):
//   - Lensing (Uni_LensTrace): a camera ray traced back through the Schwarzschild metric. Inside a
//     sphere of UNI_LENS_SPHERE_X (or 1.25 x the disc) the ray is integrated (RK4) as Riccardo
//     Antonelli's "starless" does it: in flat coordinates, with a central acceleration
//     -1.5 h^2 x / r^5 (h = |x x v|, conserved), whose orbits are exactly the photon orbits
//     u'' + u = 1.5 u^2 (u = R_s / r). Outside it the same acceleration is integrated in closed
//     form along the straight line (Uni_LensTailK): it falls as r^-5, so the far part of the
//     orbit is straight to ~b^3 / R^4 (the weak-field 2 R_s / b is the whole line's). The camera
//     is a static observer: its measured direction becomes the coordinate one by its radial part
//     x sqrt(1 - 1/r). A ray falls in (the shadow, impact parameter 3 sqrt(3) / 2) or leaves in a
//     direction the caller samples the scene in: the lens moves light, never adds it (surface
//     brightness is conserved), so a pixel is the scene's radiance where its ray came from.
//   - The disc (Uni_LensTrace's plane crossings): a thin, optically thick disc from the innermost
//     stable orbit (3 R_s) outwards, at the Shakura-Sunyaev / Page-Thorne shape
//     T ~ (x^-3 (1 - sqrt(3 / x)))^1/4, its peak the physical thin disc's (from the mass and the
//     Eddington ratio, Uni_BhDiscPeakK), floored at UNI_BH_DISC_TMIN (a slow accretor is a hot
//     thin flow, not a cool disc: the floor keeps its light warm, D-272's LINER colour). Gas on
//     circular orbits: each crossing's light shifted by g = sqrt(1 - 1.5 / x) / (1 - Omega
//     lambda) (gravity, the orbit's Doppler and beaming: Luminet 1979; lambda the photon's angular
//     momentum about the disc's axis), seen as the blackbody at g T (I_nu / nu^3 is invariant: a
//     blackbody stays one): the V band's Planck weight at g T x that temperature's colour. Its
//     scale (the caller's) makes the disc's light, averaged over every direction, the nucleus's
//     (UniCompact.h, DiscNormalization): the sprite hands its light to the disc as the disc is
//     resolved, and the nucleus's colour is the disc's (Uni_NucleusColour).
//   - Its axis: the host's disc normal tilted by up to 60 degrees (BH.SPIN; real AGN discs are only
//     loosely aligned with their hosts).
// References: R. Antonelli, "starless" (github.com/rantonels/starless); E. Bruneton, "Real-time
// high-quality rendering of non-rotating black holes" (2020); J.-P. Luminet, "Image of a spherical
// black hole with thin accretion disk" (A&A 75, 1979); O. James et al., "Gravitational lensing by
// spinning black holes in astrophysics, and in the movie Interstellar" (CQG 32, 2015).

#ifndef UNI_COMPACT_USH
#define UNI_COMPACT_USH

#include "UniCoreDefs.ush"
#include "UniSeed.ush"
#include "UniPlacement.ush"
#include "UniPhotometry.ush"   // D-273: Uni_Luminance

static const uint UNI_CH_BH_MASS = 0x1AF45697u;        // ChannelId("BH.MASS")       a galaxy black hole's mass scatter (draws 0, 1) and its host's bulge share (2) (D-272)
static const uint UNI_CH_BH_EDDINGTON = 0xEB93DBAFu;   // ChannelId("BH.EDDINGTON")  its accretion rate: accreting or quiet, and where (draw 0) (D-272)

static const float UNI_BH_LOG_LEDD = 38.100371f;       // log10 of the Eddington luminosity per solar mass, 1.26e38 erg/s
static const float UNI_BH_LOG_LSUN = 33.582971f;       // log10 of the Sun's luminosity, 3.828e33 erg/s (IAU nominal)
static const float UNI_BH_LOG_RS_SUN_CM = 5.470296f;   // log10 of the Sun's Schwarzschild radius, 2 G M_sun / c^2 = 2.9532e5 cm
static const float UNI_BH_LOG_OPT_SHARE = -1.0f;       // log10 of the accretion light's share in the V band (~10% of bolometric)
static const float UNI_BH_SUN_ABS_MAG_V = 4.83f;
static const float UNI_BH_NONE_MAG = 99.0f;            // a nucleus too faint to matter (not drawn)

// The galaxy relation (Haring & Rix 2004) and its hosts.
static const float UNI_BH_LOG_MASS_RATIO = -2.853872f;   // log10 0.0014: black hole over bulge mass
static const float UNI_BH_MASS_SCATTER_DEX = 0.3f;
static const float UNI_BH_BT_DISC_LO = 0.08f;            // a disc galaxy's bulge share, log-uniform (Sd .. Sa)
static const float UNI_BH_BT_DISC_HI = 0.45f;
static const float UNI_BH_BT_EARLY_LO = 0.6f;            // an early type's, uniform (lenticular .. elliptical)
static const float UNI_BH_BT_EARLY_HI = 1.0f;
static const float UNI_BH_ML_DISC = 2.0f;                // the bulge's V mass-to-light ratio, solar units
static const float UNI_BH_ML_EARLY = 4.0f;

// The Eddington ratio's mixture (log10 lambda).
static const float UNI_BH_EDD_SLOPE = 0.65f;             // accreting: p(log lambda) ~ lambda^-0.65 (Aird et al. 2012)
static const float UNI_BH_EDD_ACTIVE_LO = -4.0f;
static const float UNI_BH_EDD_ACTIVE_HI = 0.0f;
static const float UNI_BH_EDD_QUIET_LO = -9.0f;          // quiet: log-uniform
static const float UNI_BH_EDD_QUIET_HI = -5.0f;
static const float UNI_BH_ACTIVE_SHARE = 0.4f;           // the default accreting share (uu.Bh.ActiveFraction): 30-40% of nearby galaxies host a low-level nucleus

// D-273: the disc (the near field) and its light. D-272's colour model (5000 K at a low accretion
// rate to 25000 K at a high one) is superseded: the nucleus's colour is its disc's.
static const uint UNI_CH_BH_SPIN = 0x564A2FF7u;        // ChannelId("BH.SPIN")       its disc's axis from its host's: tilt (draw 0), azimuth (1) (D-273)
static const float UNI_BH_ISCO_X = 3.0f;               // the innermost stable circular orbit (6 G M / c^2), R_s
static const float UNI_BH_SHADOW_B = 2.5980762f;       // the shadow's impact parameter, 3 sqrt(3) / 2 R_s
static const float UNI_BH_LOG_TSTAR = 31.2612f;        // log10 T*^4 + log10 M - log10 lambda: T*^4 = 9 L / (4 pi sigma R_s^2) (K^4), with L = 1.26e38 M lambda
static const float UNI_BH_DISC_PEAK_P = 0.21402493f;   // (x^-3 (1 - sqrt(3 / x)))^1/4 at its peak, x = 49 / 12
static const float UNI_BH_DISC_TMIN = 4000.0f;         // the disc's peak temperature at least this (a slow accretor's light stays warm)
static const float UNI_BH_DISC_EDGE_K = 3000.0f;       // the disc ends where it has cooled to this (its V light gone)
static const float UNI_BH_DISC_X_MIN = 12.0f;          // .. but no nearer than this, R_s
static const float UNI_BH_DISC_X_MAX = 1000.0f;        // .. nor farther
static const float UNI_BH_DISC_FADE = 0.6f;            // opaque to this x its outer radius, then fading to none at it
static const float UNI_BH_V_HC_K = 26159.58f;          // h c / (k 550 nm): the V band's Planck weight 1 / (exp(this / T) - 1)
static const float UNI_BH_AXIS_TILT_COS = 0.5f;        // the disc's axis within 60 degrees of its host's (uniform over that cap)
static const uint UNI_BH_COLOUR_TAPS = 12u;            // Uni_NucleusColour's radii (12: 0.5% of a fine integral's chromaticity)

struct FUniBlackHole
{
	float Log10Mass;        // solar masses
	float Log10Eddington;   // the accretion rate's share of the Eddington rate
	float Log10LumBol;      // its accretion's bolometric luminosity, erg/s
	float AbsMagV;          // that light's V absolute magnitude (the V share), before any cap
};

/** A black hole of any mass from its mass and Eddington ratio (both log10). */
UNI_FN FUniBlackHole Uni_BlackHoleOf(float InLog10Mass, float InLog10Eddington)
{
	FUniBlackHole B;
	B.Log10Mass = InLog10Mass;
	B.Log10Eddington = InLog10Eddington;
	B.Log10LumBol = UNI_BH_LOG_LEDD + InLog10Mass + InLog10Eddington;
	B.AbsMagV = UNI_BH_SUN_ABS_MAG_V - 2.5f * (B.Log10LumBol + UNI_BH_LOG_OPT_SHARE - UNI_BH_LOG_LSUN);
	return B;
}

/** The Schwarzschild radius in cm (3e15 for 1e10 solar masses: a float holds it). */
UNI_FN float Uni_BhSchwarzschildCm(float InLog10Mass)
{
	return pow(10.0f, UNI_BH_LOG_RS_SUN_CM + InLog10Mass);
}

/** log10 of the Eddington ratio from one uniform draw: accreting (InActive of them, the truncated
 *  power law by its inverse CDF) or quiet (log-uniform). */
UNI_FN float Uni_BhLog10EddingtonAt(float InU, float InActive)
{
	const float Act = saturate(InActive);
	if (InU < Act)
	{
		const float V = InU / max(Act, 1.0e-6f);
		const float Lo = pow(10.0f, -UNI_BH_EDD_SLOPE * UNI_BH_EDD_ACTIVE_LO);   // 10^(-a x) at the ends
		const float Hi = pow(10.0f, -UNI_BH_EDD_SLOPE * UNI_BH_EDD_ACTIVE_HI);
		return clamp(-log10(max(Lo - V * (Lo - Hi), 1.0e-30f)) / UNI_BH_EDD_SLOPE, UNI_BH_EDD_ACTIVE_LO, UNI_BH_EDD_ACTIVE_HI);
	}
	const float W = (InU - Act) / max(1.0f - Act, 1.0e-6f);
	return UNI_BH_EDD_QUIET_LO + (UNI_BH_EDD_QUIET_HI - UNI_BH_EDD_QUIET_LO) * saturate(W);
}

/** A galaxy's bulge share of its V light (by type, from BH.MASS draw 2). */
UNI_FN float Uni_GalaxyBulgeShare(uint InSeed, bool InEarly)
{
	const float U = Uni_DrawUnit(InSeed, UNI_CH_BH_MASS, 2u);
	if (InEarly) { return UNI_BH_BT_EARLY_LO + (UNI_BH_BT_EARLY_HI - UNI_BH_BT_EARLY_LO) * U; }
	return UNI_BH_BT_DISC_LO * pow(UNI_BH_BT_DISC_HI / UNI_BH_BT_DISC_LO, U);
}

/** log10 of the bulge's mass (solar) from the host's V absolute magnitude. */
UNI_FN float Uni_GalaxyLog10BulgeMass(uint InSeed, float InHostAbsMag, bool InEarly)
{
	const float LogL = -0.4f * (InHostAbsMag - UNI_BH_SUN_ABS_MAG_V);
	return LogL + log10(Uni_GalaxyBulgeShare(InSeed, InEarly) * (InEarly ? UNI_BH_ML_EARLY : UNI_BH_ML_DISC));
}

/** The relation's scatter in units of its sigma: a standard normal (Box-Muller from BH.MASS draws 0
 *  and 1), held within 3 sigma. */
UNI_FN float Uni_GalaxyBhMassZ(uint InSeed)
{
	const float U1 = Uni_DrawUnitPos(InSeed, UNI_CH_BH_MASS, 0u);
	const float U2 = Uni_DrawUnit(InSeed, UNI_CH_BH_MASS, 1u);
	return clamp(sqrt(-2.0f * log(U1)) * cos(6.2831853f * U2), -3.0f, 3.0f);
}

/** A galaxy's supermassive black hole from its record (seed, V magnitude, early-type flag).
 *  InActive: the accreting share (uu.Bh.ActiveFraction). */
UNI_FN FUniBlackHole Uni_GalaxyBlackHole(FUniObject InObj, float InActive)
{
	const uint Seed = InObj.B.x;
	const bool bEarly = (Uni_ObjectFlags(InObj) & UNI_OBJ_FLAG_EARLY) != 0u;
	const float LogM = UNI_BH_LOG_MASS_RATIO + Uni_GalaxyLog10BulgeMass(Seed, Uni_ObjectAbsMag(InObj), bEarly) + UNI_BH_MASS_SCATTER_DEX * Uni_GalaxyBhMassZ(Seed);
	return Uni_BlackHoleOf(LogM, Uni_BhLog10EddingtonAt(Uni_DrawUnit(Seed, UNI_CH_BH_EDDINGTON, 0u), InActive));
}

/** The nucleus the galaxy shows: the black hole's V light x InGain, at most InCap x the host's;
 *  UNI_BH_NONE_MAG where under 1e-6 of the host (nothing to draw). */
UNI_FN float Uni_NucleusAbsMag(FUniBlackHole InBh, float InHostAbsMag, float InCap, float InGain)
{
	if (!(InGain > 0.0f) || !(InCap > 0.0f)) { return UNI_BH_NONE_MAG; }
	const float LogRatio = -0.4f * (InBh.AbsMagV - InHostAbsMag) + log10(InGain);   // log10 (nucleus / host)
	if (LogRatio < -6.0f) { return UNI_BH_NONE_MAG; }
	return InHostAbsMag - 2.5f * min(LogRatio, log10(InCap));
}

/** D-273: the disc's peak temperature (K): the thin disc's, T* x 0.214 at x = 49 / 12, from its
 *  mass and Eddington ratio (T* ~ (lambda / M)^1/4: ~8e4 K for 1e8 M_sun at 0.1, ~1e7 K for a
 *  stellar black hole), at least UNI_BH_DISC_TMIN. */
UNI_FN float Uni_BhDiscPeakK(FUniBlackHole InBh)
{
	const float LogT = 0.25f * (UNI_BH_LOG_TSTAR + InBh.Log10Eddington - InBh.Log10Mass);
	return max(UNI_BH_DISC_PEAK_P * pow(10.0f, LogT), UNI_BH_DISC_TMIN);
}

/** The disc's temperature at x (R_s) over its peak: 0 inside the innermost stable orbit. */
UNI_FN float Uni_BhDiscProfile(float InX)
{
	if (!(InX > UNI_BH_ISCO_X)) { return 0.0f; }
	return pow(max(1.0f - sqrt(UNI_BH_ISCO_X / InX), 0.0f) / (InX * InX * InX), 0.25f) * (1.0f / UNI_BH_DISC_PEAK_P);
}

/** The disc's outer radius (R_s): where it has cooled to UNI_BH_DISC_EDGE_K, within
 *  [UNI_BH_DISC_X_MIN, UNI_BH_DISC_X_MAX] (a fixed point of the profile, 6 rounds). */
UNI_FN float Uni_BhDiscOuterX(float InPeakK)
{
	const float Q = UNI_BH_DISC_PEAK_P * UNI_BH_DISC_EDGE_K / max(InPeakK, 1.0f);
	float X = pow(Q, -4.0f / 3.0f);
	UNI_UNROLL
	for (int I = 0; I < 6; ++I)
	{
		X = pow(Q / pow(max(1.0f - sqrt(UNI_BH_ISCO_X / max(X, 3.01f)), 1.0e-4f), 0.25f), -4.0f / 3.0f);
	}
	return clamp(X, UNI_BH_DISC_X_MIN, UNI_BH_DISC_X_MAX);
}

/** The disc's opacity at x (R_s): 1 from the innermost stable orbit to UNI_BH_DISC_FADE x its outer
 *  radius, falling smoothly to 0 at it; 0 inside the innermost stable orbit (the plunging gas). */
UNI_FN float Uni_BhDiscOpacity(float InX, float InOuterX)
{
	if (!(InX >= UNI_BH_ISCO_X) || !(InX <= InOuterX)) { return 0.0f; }
	return 1.0f - smoothstep(UNI_BH_DISC_FADE * InOuterX, InOuterX, InX);
}

/** The V band's Planck weight of a blackbody at InK (relative: 1 / (exp(hc / k lambda T) - 1)). */
UNI_FN float Uni_BhPlanckV(float InK)
{
	return 1.0f / (exp(min(UNI_BH_V_HC_K / max(InK, 1.0f), 80.0f)) - 1.0f);
}

/** A blackbody's light at InK in the disc's units: its V weight x its colour at luminance 1. */
UNI_FN float3 Uni_BhDiscLight(float InK)
{
	const float3 C = Uni_TemperatureColour(InK);
	return C * (Uni_BhPlanckV(InK) / max(Uni_Luminance(C), 1.0e-3f));
}

// D-273: the disc's light by direction (Tools/UniVerify: `univerify lenstable`, generated from the
// lens core; T1.lens.disc_light checks it between its nodes). Rows: peak temperature, ln-even from
// 4000 K to 1e7 K (36, clamped beyond); columns: cos i = 0, 1/16 .. 1 to the disc's axis (17).
//   UNI_BH_DISC_BEAM     the disc's light seen from far over its mean over directions (the nucleus
//                        sprite's factor: face-on brighter, edge-on dimmer, a small disc lifted by
//                        its own lensing);
//   UNI_BH_DISC_LOGNORM  log10 of that mean (R_s^2 x sr x Uni_BhDiscLight units at radiance scale 1).
static const uint UNI_BH_BEAM_NT = 36u;
static const uint UNI_BH_BEAM_NM = 17u;
static const float UNI_BH_BEAM_LNT0 = 8.294050f;   // ln 4000
static const float UNI_BH_BEAM_DLNT = 0.223544f;   // ln(1e7 / 4000) / 35
static const float UNI_BH_DISC_BEAM[612] = {
