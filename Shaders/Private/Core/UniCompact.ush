};
static const float UNI_BH_DISC_LOGNORM[36] = {
	-1.21578f, -0.59245f, 0.00327f, 0.51158f, 0.95678f, 1.35538f, 1.71896f, 2.05557f, 2.37314f, 2.67628f, 2.96889f, 3.25360f, 3.53253f, 3.80703f, 4.07831f, 4.34710f, 4.60275f, 4.84417f, 5.06801f, 5.27266f, 5.45867f, 5.62797f, 5.78303f, 5.92636f, 6.06023f, 6.18652f, 6.30680f, 6.42231f, 6.53404f, 6.64277f, 6.74914f, 6.85361f, 6.95659f, 7.05838f, 7.15921f, 7.25929f
};

/** The table's row position of a peak temperature (clamped to the grid). */
UNI_FN float Uni_BhBeamRow(float InPeakK)
{
	return clamp((log(max(InPeakK, 1.0f)) - UNI_BH_BEAM_LNT0) / UNI_BH_BEAM_DLNT, 0.0f, (float)(UNI_BH_BEAM_NT - 1u));
}

/** The nucleus's light towards a direction at |cos i| to its disc's axis, over its mean over
 *  directions (bilinear in the table). */
UNI_FN float Uni_BhDiscBeam(float InPeakK, float InAbsCosI)
{
	const float Tr = Uni_BhBeamRow(InPeakK);
	const uint T0 = min((uint)Tr, UNI_BH_BEAM_NT - 2u);
	const float Ft = Tr - (float)T0;
	const float Mr = saturate(InAbsCosI) * (float)(UNI_BH_BEAM_NM - 1u);
	const uint M0 = min((uint)Mr, UNI_BH_BEAM_NM - 2u);
	const float Fm = Mr - (float)M0;
	const uint I0 = T0 * UNI_BH_BEAM_NM + M0;
	const float A = UNI_BH_DISC_BEAM[I0] + (UNI_BH_DISC_BEAM[I0 + 1u] - UNI_BH_DISC_BEAM[I0]) * Fm;
	const float B = UNI_BH_DISC_BEAM[I0 + UNI_BH_BEAM_NM] + (UNI_BH_DISC_BEAM[I0 + UNI_BH_BEAM_NM + 1u] - UNI_BH_DISC_BEAM[I0 + UNI_BH_BEAM_NM]) * Fm;
	return A + (B - A) * Ft;
}

/** log10 of the disc's light averaged over directions at radiance scale 1 (linear in ln T). */
UNI_FN float Uni_BhDiscLog10Norm(float InPeakK)
{
	const float Tr = Uni_BhBeamRow(InPeakK);
	const uint T0 = min((uint)Tr, UNI_BH_BEAM_NT - 2u);
	const float Ft = Tr - (float)T0;
	return UNI_BH_DISC_LOGNORM[T0] + (UNI_BH_DISC_LOGNORM[T0 + 1u] - UNI_BH_DISC_LOGNORM[T0]) * Ft;
}

/** The nucleus's colour (brightest channel 1): its disc's light summed over its radii
 *  (UNI_BH_COLOUR_TAPS, even in ln x from the innermost stable orbit to the outer radius, each
 *  annulus x its opacity), unshifted: within 0.5% of the disc's colour averaged over every
 *  direction with its shifts (1% where the peak is near the floor), so the sprite and the disc it
 *  hands its light to agree. */
UNI_FN float3 Uni_NucleusColour(FUniBlackHole InBh)
{
	const float Peak = Uni_BhDiscPeakK(InBh);
	const float Outer = Uni_BhDiscOuterX(Peak);
	const float LnSpan = log(Outer / UNI_BH_ISCO_X);
	float3 Sum = float3(0.0f, 0.0f, 0.0f);
	UNI_UNROLL
	for (uint I = 0u; I < UNI_BH_COLOUR_TAPS; ++I)
	{
		const float X = UNI_BH_ISCO_X * exp(LnSpan * (((float)I + 0.5f) / (float)UNI_BH_COLOUR_TAPS));
		Sum += Uni_BhDiscLight(Peak * Uni_BhDiscProfile(X)) * (Uni_BhDiscOpacity(X, Outer) * X * X);   // x dx = x^2 d(ln x)
	}
	const float M = max(Sum.x, max(Sum.y, Sum.z));
	return M > 0.0f ? Sum / M : Uni_TemperatureColour(Peak);
}

/** The disc's axis: its host's disc normal (unit) tilted within UNI_BH_AXIS_TILT_COS (uniform over
 *  the cap; BH.SPIN draws 0, 1). */
UNI_FN float3 Uni_BhDiscAxis(uint InSeed, float3 InHostNormal)
{
	const float CosT = 1.0f - (1.0f - UNI_BH_AXIS_TILT_COS) * Uni_DrawUnit(InSeed, UNI_CH_BH_SPIN, 0u);
	const float SinT = sqrt(max(1.0f - CosT * CosT, 0.0f));
	const float Az = 6.2831853f * Uni_DrawUnit(InSeed, UNI_CH_BH_SPIN, 1u);
	const float3 N = normalize(InHostNormal);
	const float3 Ref = abs(N.z) < 0.9f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
	const float3 E1 = normalize(cross(Ref, N));
	const float3 E2 = cross(N, E1);
	return normalize(N * CosT + (E1 * cos(Az) + E2 * sin(Az)) * SinT);
}

/** D-274 (owner 2026-11-17: "the brightness of the black hole up close is much too bright for me
 *  to inspect the effect, it is masked by the bloom and flare"): the disc's light per pixel
 *  (exposure units) softened above a knee: unchanged up to it, then Knee (1 + log10(L / Knee)),
 *  its colour kept. Continuous and monotone (the slope drops to 1 / ln 10 at the knee): 10x the knee reads 2x, 1e8x
 *  (an active nucleus's inner disc a few hundred R_s away) 9x, so the disc's structure (the
 *  Doppler side, the lifted far side, the photon ring) survives under bloom. Render only; a knee
 *  of 0 is physical. */
static const float UNI_BH_DISC_KNEE = 2.0f;            // uu.Bh.DiscKnee's default (exposure units per pixel)

UNI_FN float3 Uni_BhDiscSoften(float3 InRgb, float InKnee)
{
	if (!(InKnee > 0.0f)) { return InRgb; }
	const float L = Uni_Luminance(InRgb);
	if (!(L > InKnee)) { return InRgb; }
	return InRgb * (InKnee * (1.0f + log10(L / InKnee)) / L);
}

// ------------------------------------------------------------------------------------------
// D-273: lensing and the disc along a camera ray (units of R_s, the black hole at the origin)
// ------------------------------------------------------------------------------------------

static const float UNI_LENS_SPHERE_X = 200.0f;     // the integrated sphere's radius at least this, R_s (1.25 x the disc's outer radius when larger): beyond it the closed form's 2nd order (15 pi / 16 b^2) is under 1e-4 rad
static const float UNI_LENS_STEP = 0.06f;          // an RK4 step is this x r (speed-normalised) within UNI_LENS_NEAR_X; x0.5 inside 3 R_s, where rays wind about the photon sphere
static const float UNI_LENS_STEP_FAR = 0.15f;      // .. and this beyond it (nearly straight)
static const float UNI_LENS_NEAR_X = 20.0f;
static const uint UNI_LENS_MAX_STEPS = 400u;       // a ray still winding after this many is taken as fallen in (it is within ~1e-4 of the shadow's edge)
static const uint UNI_LENS_MAX_CROSSINGS = 4u;     // disc crossings shaded (the 4th image is ~e^-3pi fainter)

struct FUniLensDisc
{
	float3 Axis;        // unit, world axes
	float OuterX;       // its outer radius, R_s (Uni_BhDiscOuterX)
	float PeakK;        // its peak temperature (Uni_BhDiscPeakK)
	float bDisc;        // 0: no disc (lensing alone)
	float Pad0;
	float Pad1;
	// D-276: the volumetric disc (Thickness > 0; 0: D-273's thin disc) and its look.
	float3 E1;          // a unit vector in its plane (the azimuth's zero; E2 = Axis x E1)
	float Thickness;    // its Gaussian half-thickness over the radius, H = Thickness x rho (flared)
	float Opacity;      // its optical depth through the plane at mean density
	float Clouds;       // 0..1: smooth .. clumped (cloud gaps the sky shows through)
	float Bands;        // the rings' brightness contrast (0: none)
	float Heat;         // the clumps' temperature contrast (0: none)
	float Spiral;       // the clouds' log-spiral winding (radians per e-fold of radius)
	float OmegaIsco;    // the gas's angular speed at the innermost stable orbit, rad / s (art; Keplerian outwards)
	float FlowTA;       // the two flow phases' times (s) ..
	float FlowTB;
	float FlowWA;       // .. and phase A's weight (B's 1 - it)
	uint SeedA;         // the two phases' cloud seeds (a fresh cloud pattern each cycle)
	uint SeedB;
	uint MaxSamples;    // the most volume samples a ray takes (0: UNI_LENS_VOL_SAMPLES)
	float Falloff;      // the light's fall with temperature: (Planck(gT) / Planck(peak))^Falloff x Planck(peak) (1: physical, the V band's; < 1: the cooler outer disc glows)
	float Erosion;      // D-278: 0..1: the clouds' edges, the disc's top surface and rim eaten by a finer noise (0: D-276's)
	float LookPad1;
	float LookPad2;
};

struct FUniLensResult
{
	float3 Dir;         // where the ray came from: its direction at infinity (world axes; any when it fell in)
	float Captured;     // 1: it fell in (the shadow)
	float3 Disc;        // the disc's light along it (Uni_BhDiscLight units, each crossing x its opacity x what is in front)
	float Transmit;     // the share of the scene behind still seen through the disc
	float Steps;        // RK4 steps taken
	float Deflection;   // angle between the ray's direction at the camera and Dir, rad
	float ImpactB;      // the photon's impact parameter, R_s
	float3 FirstPos;    // the first disc crossing (R_s; diagnostics) ..
	float FirstX;       // .. its radius (0: none) ..
	float FirstG;       // .. and its shift g
	float Pad0;
	float Pad1;
	float Pad2;
};

// D-276: the volumetric disc's clouds (owner 2026-11-17 10:23: "disc clouds rather than a static disc
// ... some form of noise ... potentially with like spiral distortion"; "rotation ... bands of
// differing light intensity and fusion colors"; "volume ... that can be transited through"). Value
// noise (an integer lattice hash: the same on the GPU and the CPU), fBm in the disc's co-rotating
// cylinder (cos, sin of the azimuth winding as a log spiral; ln radius; height over the thickness),
// so it has no seam. Differential rotation would wind any pattern into ever thinner threads: two
// flow phases (Vlachos, "Water flow in Portal 2", 2010) each advect it for one cycle and restart
// with a fresh seed, cross-faded (each phase's weight 0 at its restart).
static const uint UNI_LENS_VOL_SAMPLES = 192u;     // the volume samples a ray takes at half a thickness apart (D-278 with erosion: mean 74, past it 2% of rays); past it one an RK4 step
static const float UNI_BH_VOL_INNER = 2.6f;        // the volume's inner edge (R_s): the plunging gas thins from here to the ISCO
static const float UNI_BH_CLOUD_FA = 2.5f;         // the clouds' frequency around the disc (cylinder radius in noise units)
static const float UNI_BH_CLOUD_FR = 3.0f;         // .. along ln radius
static const float UNI_BH_CLOUD_FZ = 0.5f;         // .. through its height (per thickness)
static const float UNI_BH_BAND_RINGS = 7.0f;       // rings across the disc (even in ln radius)

UNI_FN float Uni_BhHash(float3 InC, uint InSeed)
{
	const uint X = (uint)((int)InC.x), Y = (uint)((int)InC.y), Z = (uint)((int)InC.z);
	const uint H = Uni_Avalanche((X * 73856093u) ^ (Y * 19349663u) ^ (Z * 83492791u) ^ (InSeed * 2654435761u));
	return (float)(H & 0xFFFFFFu) * (1.0f / 16777216.0f);
}

/** Value noise in [0, 1] (quintic fade). */
UNI_FN float Uni_BhNoise(float3 InP, uint InSeed)
{
	const float3 I = float3(floor(InP.x), floor(InP.y), floor(InP.z));
	const float3 F = InP - I;
	const float3 U = F * F * F * (F * (F * 6.0f - float3(15.0f, 15.0f, 15.0f)) + float3(10.0f, 10.0f, 10.0f));
	const float A = lerp(Uni_BhHash(I, InSeed), Uni_BhHash(I + float3(1.0f, 0.0f, 0.0f), InSeed), U.x);
	const float B = lerp(Uni_BhHash(I + float3(0.0f, 1.0f, 0.0f), InSeed), Uni_BhHash(I + float3(1.0f, 1.0f, 0.0f), InSeed), U.x);
	const float C = lerp(Uni_BhHash(I + float3(0.0f, 0.0f, 1.0f), InSeed), Uni_BhHash(I + float3(1.0f, 0.0f, 1.0f), InSeed), U.x);
	const float D = lerp(Uni_BhHash(I + float3(0.0f, 1.0f, 1.0f), InSeed), Uni_BhHash(I + float3(1.0f, 1.0f, 1.0f), InSeed), U.x);
	return lerp(lerp(A, B, U.y), lerp(C, D, U.y), U.z);
}

/** 3 octaves of it (mean ~0.5). */
UNI_FN float Uni_BhFbm(float3 InP, uint InSeed)
{
	return (Uni_BhNoise(InP, InSeed) * 0.5714f + Uni_BhNoise(InP * 2.03f + float3(17.1f, 9.3f, 3.7f), InSeed + 1u) * 0.2857f
		+ Uni_BhNoise(InP * 4.11f + float3(5.3f, 31.7f, 11.1f), InSeed + 2u) * 0.1429f);
}

/** The clouds at a point (disc frame: Rho, the azimuth's cos / sin, Z), one flow phase. */
UNI_FN float Uni_BhCloudPhase(float InLnR, float InCos, float InSin, float InZh, float InTurn, uint InSeed)
{
	const float C = cos(InTurn), S = sin(InTurn);
	const float Cr = InCos * C + InSin * S, Sr = InSin * C - InCos * S;   // the azimuth turned back by InTurn
	return Uni_BhFbm(float3(Cr * UNI_BH_CLOUD_FA, Sr * UNI_BH_CLOUD_FA, InLnR * UNI_BH_CLOUD_FR + InZh * UNI_BH_CLOUD_FZ), InSeed);
}

/** D-278: the clouds' erosion detail, one flow phase: 2 octaves at 5x the clouds' frequency (3x
 *  through the height), moving with the gas (the same turn). */
UNI_FN float Uni_BhDetailPhase(float InLnR, float InCos, float InSin, float InZh, float InTurn, uint InSeed)
{
	const float C = cos(InTurn), S = sin(InTurn);
	const float Cr = InCos * C + InSin * S, Sr = InSin * C - InCos * S;
	const float3 P = float3(Cr * (5.0f * UNI_BH_CLOUD_FA), Sr * (5.0f * UNI_BH_CLOUD_FA), InLnR * (5.0f * UNI_BH_CLOUD_FR) + InZh * (3.0f * UNI_BH_CLOUD_FZ));
	return Uni_BhNoise(P, InSeed + 11u) * 0.6667f + Uni_BhNoise(P * 2.07f + float3(7.7f, 3.1f, 13.3f), InSeed + 12u) * 0.3333f;
}

/** The volumetric disc at a point (R_s, world axes about the hole): its absorption (per R_s) and
 *  source (Uni_BhDiscLight units: the light it shows where optically thick), shifted by the gas's
 *  motion for a photon of angular momentum InLambda about the axis. */
UNI_FN void Uni_BhDiscSample(float3 InP, FUniLensDisc InDisc, float InLambda, UNI_OUT(float) OutAlpha, UNI_OUT(float3) OutSource)
{
	OutAlpha = 0.0f;
	OutSource = float3(0.0f, 0.0f, 0.0f);
	const float Z = dot(InP, InDisc.Axis);
	const float3 Pp = InP - InDisc.Axis * Z;
	const float Rho = length(Pp);
	if (!(Rho > UNI_BH_VOL_INNER) || !(Rho < InDisc.OuterX)) { return; }
	const float H = max(InDisc.Thickness * Rho, 1.0e-4f);
	const float Zh0 = Z / H;
	if (abs(Zh0) > 3.5f * (1.0f + 0.5f * InDisc.Erosion)) { return; }
	const float3 E2 = cross(InDisc.Axis, InDisc.E1);
	const float Cs = dot(Pp, InDisc.E1) / Rho, Sn = dot(Pp, E2) / Rho;
	const float LnR = log(Rho * (1.0f / UNI_BH_ISCO_X));
	// Its angular speed (Keplerian from the ISCO's), the turn each phase has advected it by, and the spiral.
	const float Om = InDisc.OmegaIsco * pow(max(Rho * (1.0f / UNI_BH_ISCO_X), 0.1f), -1.5f);
	const float Wind = InDisc.Spiral * LnR;
	const float Na = Uni_BhCloudPhase(LnR, Cs, Sn, Zh0, Om * InDisc.FlowTA - Wind, InDisc.SeedA);
	const float Nb = Uni_BhCloudPhase(LnR, Cs, Sn, Zh0, Om * InDisc.FlowTB - Wind, InDisc.SeedB);
	float N = Na * InDisc.FlowWA + Nb * (1.0f - InDisc.FlowWA);
	// D-278: erosion (the volumetric-cloud way, Schneider 2015): a finer noise eats the clouds' thin
	// edges and leaves their cores; it also roughens the disc's top surface (the height scaled by
	// it) and its outer rim. Off at Erosion 0 (D-276's disc exactly).
	float Zh = Zh0;
	float RhoEdge = Rho;
	if (InDisc.Erosion > 0.0f)
	{
		// Its own, looser winding (a quarter of the clouds'): it cuts across their streaks.
		const float Da = Uni_BhDetailPhase(LnR, Cs, Sn, Zh0, Om * InDisc.FlowTA - 0.25f * Wind, InDisc.SeedA);
		const float Db = Uni_BhDetailPhase(LnR, Cs, Sn, Zh0, Om * InDisc.FlowTB - 0.25f * Wind, InDisc.SeedB);
		const float Dn = Da * InDisc.FlowWA + Db * (1.0f - InDisc.FlowWA);
		N = N - InDisc.Erosion * 0.4f * Dn * (1.0f - smoothstep(0.45f, 0.85f, N));
		Zh = Zh0 / max(1.0f + InDisc.Erosion * 0.8f * (Dn - 0.5f) + InDisc.Erosion * 0.5f * (N - 0.5f), 0.3f);
		RhoEdge = Rho * (1.0f + InDisc.Erosion * 0.25f * (Dn - 0.5f));
	}
	const float Clump = lerp(1.0f, 2.0f * smoothstep(0.40f, 0.66f, N), saturate(InDisc.Clouds));
	const float Edge = Uni_BhDiscOpacity(max(RhoEdge, UNI_BH_ISCO_X), InDisc.OuterX) * smoothstep(UNI_BH_VOL_INNER, UNI_BH_ISCO_X + 0.2f, Rho);
	OutAlpha = InDisc.Opacity * (0.39894f / H) * exp(-0.5f * Zh * Zh) * Clump * Edge;
	// Its light: the thin disc's temperature, the clumps hotter (Heat), the rings (Bands), shifted by g.
	const float Omega = sqrt(0.5f / (Rho * Rho * Rho));
	const float G = sqrt(max(1.0f - 1.5f / Rho, 0.0f)) / max(1.0f - Omega * InLambda, 1.0e-3f);
	const float T = InDisc.PeakK * Uni_BhDiscProfile(max(Rho, UNI_BH_ISCO_X + 1.0e-3f)) * (1.0f + InDisc.Heat * (2.0f * N - 1.0f));
	const float Span = max(log(InDisc.OuterX * (1.0f / UNI_BH_ISCO_X)), 0.1f);
	const float Band = max(1.0f + InDisc.Bands * sin(6.2831853f * UNI_BH_BAND_RINGS * LnR / Span + 3.0f * N), 0.0f);
	const float Tg = G * max(T, 1.0f);
	const float3 C = Uni_TemperatureColour(Tg);
	const float Pk = max(Uni_BhPlanckV(InDisc.PeakK), 1.0e-30f);
	const float Lv = InDisc.Falloff > 0.0f && InDisc.Falloff != 1.0f ? Pk * pow(max(Uni_BhPlanckV(Tg) / Pk, 1.0e-30f), InDisc.Falloff) : Uni_BhPlanckV(Tg);
	OutSource = C * (Lv * Band / max(Uni_Luminance(C), 1.0e-3f));
}

/** The straight line's share of the deflection beyond a point at InSigma along it (from the
 *  closest approach, signed) with impact InB: K(+inf) - K(InSigma) is what bends the line from
 *  there on, K(InSigma) - K(-inf) up to there. K(sigma) = s (2 s^2 + 3) / (2 b (1 + s^2)^1.5),
 *  s = sigma / b; +-1 / b at the ends (the whole line: 2 / b, the weak-field deflection). */
UNI_FN float Uni_LensTailK(float InSigma, float InB)
{
	const float S = InSigma / InB;
	if (abs(S) > 1.0f)
	{
		const float T2 = 1.0f / (S * S);   // (b / sigma)^2, no cancellation far away
		return (S > 0.0f ? 1.0f : -1.0f) * (2.0f + 3.0f * T2) / (2.0f * InB * pow(1.0f + T2, 1.5f));
	}
	return S * (2.0f * S * S + 3.0f) / (2.0f * InB * pow(1.0f + S * S, 1.5f));
}

/** InDir turned by InAngle towards the black hole, in the plane of InPos and InDir. */
UNI_FN float3 Uni_LensBend(float3 InDir, float3 InPos, float InAngle)
{
	const float3 C = InPos - InDir * dot(InPos, InDir);   // the line's closest point
	const float B = length(C);
	if (!(B > 1.0e-20f)) { return InDir; }
	const float3 N = C * (-1.0f / B);
	return normalize(InDir * cos(InAngle) + N * sin(InAngle));
}

/** The flat-coordinate acceleration whose orbits are the photon orbits (h2 = |x x v|^2). */
UNI_FN float3 Uni_LensAccel(float3 InX, float InH2)
{
	const float R2 = dot(InX, InX);
	const float InvR = rsqrt(R2);
	const float InvR5 = InvR * InvR * InvR * InvR * InvR;
	return InX * (-1.5f * InH2 * InvR5);
}

/** One camera ray: InCam the camera relative to the black hole (R_s, world axes), InDir the
 *  direction it looks in (unit, as a static observer there measures it). */
UNI_FN FUniLensResult Uni_LensTrace(float3 InCam, float3 InDir, FUniLensDisc InDisc, uint InMaxSteps)
{
	FUniLensResult Res;
	Res.Dir = InDir;
	Res.Captured = 0.0f;
	Res.Disc = float3(0.0f, 0.0f, 0.0f);
	Res.Transmit = 1.0f;
	Res.Steps = 0.0f;
	Res.Deflection = 0.0f;
	Res.ImpactB = 0.0f;
	Res.FirstPos = float3(0.0f, 0.0f, 0.0f);
	Res.FirstX = 0.0f;
	Res.FirstG = 0.0f;
	Res.Pad0 = 0.0f;
	Res.Pad1 = 0.0f;
	Res.Pad2 = 0.0f;
	const float Rc = length(InCam);
	if (!(Rc > 1.0001f)) { Res.Captured = 1.0f; return Res; }   // at or inside the horizon: dark
	// The static observer's direction -> the coordinate one: its radial part x sqrt(1 - 1/r).
	const float3 Rhat = InCam * (1.0f / Rc);
	const float Dr = dot(InDir, Rhat);
	const float3 D0 = normalize(InDir + Rhat * (Dr * (sqrt(1.0f - 1.0f / Rc) - 1.0f)));
	const float Sphere = max(UNI_LENS_SPHERE_X, 1.25f * InDisc.OuterX);

	float3 X = InCam;
	float3 V = D0;
	if (Rc > Sphere)
	{
		// Outside the sphere: straight to it (or past it), bent in closed form.
		const float Sig = dot(InCam, D0);                 // signed position along the line (closest approach 0)
		const float B = length(InCam - D0 * Sig);
		Res.ImpactB = B;
		if (!(B < Sphere) || Sig >= 0.0f)
		{
			Res.Dir = Uni_LensBend(D0, InCam, 1.0f / max(B, 1.0e-20f) - Uni_LensTailK(Sig, B));
			Res.Deflection = acos(clamp(dot(Res.Dir, InDir), -1.0f, 1.0f));
			return Res;
		}
		const float SigIn = -sqrt(max(Sphere * Sphere - B * B, 0.0f));
		V = Uni_LensBend(D0, InCam, Uni_LensTailK(SigIn, B) - Uni_LensTailK(Sig, B));
		X = InCam + D0 * (SigIn - Sig);
	}
	// The photon's conserved quantities: h (the flat orbit's), its plane, its impact parameter b
	// (1/b^2 = 1/(r sin psi)^2 - 1/r^3 in the coordinate angle psi: the orbit equation's first
	// integral), and its angular momentum about the disc's axis per unit energy (the photon runs
	// against the traced ray: lambda = -b (plane . axis)).
	const float3 Hv = cross(X, V);
	const float H2 = dot(Hv, Hv);
	const float R0 = length(X);
	const float HGeom = sqrt(H2);
	const float BPhys = HGeom * rsqrt(max(1.0f - H2 / (R0 * R0 * R0), 1.0e-6f));
	Res.ImpactB = BPhys;
	const float Lambda = HGeom > 1.0e-20f ? -BPhys * dot(Hv, InDisc.Axis) / HGeom : 0.0f;
	uint Crossings = 0u;
	uint VolLeft = InDisc.MaxSamples > 0u ? InDisc.MaxSamples : UNI_LENS_VOL_SAMPLES;
	float Steps = 0.0f;
	bool bDone = false;
	UNI_LOOP
	for (uint I = 0u; I < InMaxSteps; ++I)
	{
		const float R = length(X);
		if (R < 1.5f && dot(X, V) < 0.0f) { Res.Captured = 1.0f; bDone = true; break; }   // inside the photon sphere, inwards: falls in
		if (R > Sphere && dot(X, V) > 0.0f)
		{
			const float3 Vn = normalize(V);
			const float Sig = dot(X, Vn);
			const float B = length(X - Vn * Sig);
			Res.Dir = Uni_LensBend(Vn, X, 1.0f / max(B, 1.0e-20f) - Uni_LensTailK(Sig, B));
			bDone = true;
			break;
		}
		const float Speed = length(V);
		const float K = R < UNI_BH_ISCO_X ? 0.5f * UNI_LENS_STEP : (R < UNI_LENS_NEAR_X ? UNI_LENS_STEP : UNI_LENS_STEP_FAR);
		const float Dt = K * R / max(Speed, 1.0e-6f);
		const float3 K1x = V;
		const float3 K1v = Uni_LensAccel(X, H2);
		const float3 K2x = V + K1v * (0.5f * Dt);
		const float3 K2v = Uni_LensAccel(X + K1x * (0.5f * Dt), H2);
		const float3 K3x = V + K2v * (0.5f * Dt);
		const float3 K3v = Uni_LensAccel(X + K2x * (0.5f * Dt), H2);
		const float3 K4x = V + K3v * Dt;
		const float3 K4v = Uni_LensAccel(X + K3x * Dt, H2);
		const float3 X1 = X + (K1x + K2x * 2.0f + K3x * 2.0f + K4x) * (Dt / 6.0f);
		V = V + (K1v + K2v * 2.0f + K3v * 2.0f + K4v) * (Dt / 6.0f);
		Steps += 1.0f;
		// D-276: the volumetric disc: samples along this step's chord where it passes through the
		// slab (front to back: dI = (S - I) alpha ds, the step's transmittance exact per sample).
		if (InDisc.bDisc > 0.0f && InDisc.Thickness > 0.0f)
		{
			const float Z0 = dot(X, InDisc.Axis), Z1 = dot(X1, InDisc.Axis);
			const float Rho0 = length(X - InDisc.Axis * Z0), Rho1 = length(X1 - InDisc.Axis * Z1);
			const float ZMin = (Z0 > 0.0f) != (Z1 > 0.0f) ? 0.0f : min(abs(Z0), abs(Z1));
			if (ZMin < 3.5f * InDisc.Thickness * max(Rho0, Rho1) && max(Rho0, Rho1) > UNI_BH_VOL_INNER && min(Rho0, Rho1) < InDisc.OuterX)
			{
				const float Seg = length(X1 - X);
				const float Hloc = max(InDisc.Thickness * max(min(Rho0, Rho1), UNI_BH_ISCO_X), 1.0e-3f);
				// Half a thickness apart, at most 24 a step; past the ray's budget one a step (no hard cut).
				const uint Want = clamp((uint)ceil(Seg / (0.5f * Hloc)), 1u, 24u);
				const uint Ns = VolLeft > 0u ? min(Want, VolLeft) : 1u;
				VolLeft -= min(Ns, VolLeft);
				Res.Pad0 += (float)Ns;   // samples taken (diagnostics)
				const float Ds = Seg / (float)Ns;
				for (uint Ks = 0u; Ks < Ns; ++Ks)
				{
					const float3 P = X + (X1 - X) * (((float)Ks + 0.5f) / (float)Ns);
					float Al;
					float3 Src;
					Uni_BhDiscSample(P, InDisc, Lambda, Al, Src);
					if (Al > 0.0f)
					{
						const float Tr = exp(-Al * Ds);
						if (Res.FirstX == 0.0f) { Res.FirstPos = P; Res.FirstX = length(P); }
						Res.Disc += Src * (Res.Transmit * (1.0f - Tr));
						Res.Transmit *= Tr;
					}
				}
				if (Res.Transmit < 1.0e-3f) { Res.Transmit = 0.0f; bDone = true; X = X1; break; }
			}
		}
		// The disc's plane crossed: its light there (front to back), if the gas is there (D-273's thin disc).
		const float S0 = dot(X, InDisc.Axis);
		const float S1 = dot(X1, InDisc.Axis);
		if (InDisc.bDisc > 0.0f && !(InDisc.Thickness > 0.0f) && (S0 > 0.0f) != (S1 > 0.0f) && Crossings < UNI_LENS_MAX_CROSSINGS)
		{
			const float3 Xc = X + (X1 - X) * (S0 / (S0 - S1));
			const float Xr = length(Xc);
			const float A = Uni_BhDiscOpacity(Xr, InDisc.OuterX);
			if (A > 0.0f)
			{
				const float Omega = sqrt(0.5f / (Xr * Xr * Xr));   // Keplerian, about the axis (counter-clockwise)
				const float G = sqrt(max(1.0f - 1.5f / Xr, 0.0f)) / max(1.0f - Omega * Lambda, 1.0e-3f);
				if (Crossings == 0u) { Res.FirstPos = Xc; Res.FirstX = Xr; Res.FirstG = G; }
				++Crossings;
				Res.Disc += Uni_BhDiscLight(G * InDisc.PeakK * Uni_BhDiscProfile(Xr)) * (A * Res.Transmit);
				Res.Transmit *= 1.0f - A;
				if (Res.Transmit < 1.0e-3f) { Res.Transmit = 0.0f; bDone = true; X = X1; break; }
			}
		}
		X = X1;
	}
	Res.Steps = Steps;
	if (!bDone) { Res.Captured = 1.0f; }   // still winding at the photon sphere: on the shadow's edge
	if (Res.Captured < 0.5f && Res.Transmit > 0.0f) { Res.Deflection = acos(clamp(dot(Res.Dir, InDir), -1.0f, 1.0f)); }
	return Res;
}

/** The triangle wave of period 4: [-1, 1] to itself, mirrored back beyond. */
UNI_FN float Uni_LensFold(float InX)
{
	const float A = InX - 1.0f;
	return abs(A - 4.0f * floor(A * 0.25f) - 2.0f) - 1.0f;
}

/** A direction's place in the view (NDC, x right, y up), folded back into it by mirroring when it
 *  is off screen or behind (the lens pass has only the screen; the strongly bent rays that leave
 *  it are the thin rings about the shadow). InFold 0: unfolded (may be outside [-1, 1]). */
UNI_FN float2 Uni_LensSkyNdc(float3 InDir, float3 InFwd, float3 InRight, float3 InUp, float2 InTanHalf, bool InFold)
{
	float Fz = dot(InDir, InFwd);
	if (InFold && Fz < 1.0e-3f) { Fz = max(-Fz, 1.0e-3f); }   // behind: the mirror image through the eye's plane
	const float Fs = max(Fz, 1.0e-6f);
	float2 N = float2(dot(InDir, InRight) / (Fs * InTanHalf.x), dot(InDir, InUp) / (Fs * InTanHalf.y));
	if (InFold)
	{
		N = float2(Uni_LensFold(N.x), Uni_LensFold(N.y));
	}
	return N;
}

#endif // UNI_COMPACT_USH
