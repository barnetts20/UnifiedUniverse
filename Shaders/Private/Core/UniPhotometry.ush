// UniPhotometry.ush
// Radial compression f(r), apparent magnitude, visibility fade, sensitivity scaling.
// Shared by the GPU project-and-cull pass and the CPU reference renderer.
//
// Constants are the provisional baselines from D-009 and D-011. They are defined ONCE, here,
// and the CPU reads them through the shim (UniHlsl::UNI_M_REF ...), so level assignment and
// rendering can never disagree about them. m_ref and theta_min feed level assignment:
// changing either rerolls content (D-011, HIGH reroll impact).

#ifndef UNI_PHOTOMETRY_USH
#define UNI_PHOTOMETRY_USH

#include "UniCoreDefs.ush"

static const float UNI_M_REF = 6.5f;            // baseline limiting magnitude, V band (D-011)
static const float UNI_THETA_MIN = 8.0e-4f;     // rad, about 1 px at 1920 px over 90 degrees (D-011)
static const float UNI_MU_REF = 25.0f;          // mag / arcsec^2 surface-brightness limit (D-011)
static const float UNI_DM_MIN = -5.0f;          // sensitivity clamp (D-011)
static const float UNI_DM_MAX = 5.0f;
static const float UNI_FADE_BAND = 0.5f;        // mag: intensity reaches zero across [m_lim - 0.5, m_lim]
static const float UNI_R0_CM = 1.0e9f;          // promotion radius and compression knee (D-009)
static const float UNI_TEN_PC_CM = 3.0856775e19f;
static const int UNI_WINDOW_N = 2;              // D-010: half-width; frozen once content exists
static const int UNI_WINDOW_N_MAX = 6;          // D-010: sensitivity cap (13^3 cells)
static const int UNI_VELOCITY_LOD_K = 4;        // D-010: suspend when a cell is crossed faster than once per K frames

/** Euclidean length without overflow for components up to float max. */
UNI_FN float Uni_SafeLength(float3 InV)
{
	const float M = max(abs(InV.x), max(abs(InV.y), abs(InV.z)));
	if (M <= 0.0f) { return 0.0f; }
	const float3 S = InV * (1.0f / M);
	return M * sqrt(dot(S, S));
}

/** f(r): identity inside r0, logarithmic outside. Monotonic and C1 at r0. All of 2^128 cm
 *  fits inside about 69 r0 of render space. */
UNI_FN float Uni_Compress(float InR)
{
	return (InR <= UNI_R0_CM) ? InR : UNI_R0_CM * (1.0f + log(InR / UNI_R0_CM));
}

UNI_FN float Uni_CompressInverse(float InS)
{
	return (InS <= UNI_R0_CM) ? InS : UNI_R0_CM * exp(InS / UNI_R0_CM - 1.0f);
}

/** D-146: the main scene is in render space. Real space (unit scale) inside r0, and promoted
 *  actors beyond it are placed by the parallax rule: scaled about the eye by f(d)/d, d the
 *  distance to their centre. A scene distance s along a ray is read back as true distance
 *  f^-1(s). Exact inside r0. For a compressed body the result is never farther than the true
 *  surface, so what is behind it is always hidden, and what is in front is kept unless it lies
 *  within (1 + ln(d / r0)) R of the body's near surface (T3.occlusion). Sky (3e38) stays sky. */
UNI_FN float Uni_SceneTrueDistance(float InSceneDistance)
{
	if (!(InSceneDistance < 1.0e37f)) { return 3.0e38f; }
	// Above ~88 r0 the exponent overflows float: everything past it is beyond 2^128 cm anyway.
	return (InSceneDistance < 88.0f * UNI_R0_CM) ? Uni_CompressInverse(InSceneDistance) : 3.0e38f;
}

/** df/dr, for tests and for screen-space size scaling diagnostics. */
UNI_FN float Uni_CompressSlope(float InR)
{
	return (InR <= UNI_R0_CM) ? 1.0f : UNI_R0_CM / InR;
}

/** Apparent magnitude of a point source with absolute magnitude M at distance r (cm). */
UNI_FN float Uni_ApparentMag(float InAbsMag, float InDistanceCm)
{
	return InAbsMag + 5.0f * log10(max(InDistanceCm, 1.0f) / UNI_TEN_PC_CM);
}

/** k = 10^(dm/5): the factor sensitivity applies to every relevance radius. */
UNI_FN float Uni_SensitivityScale(float InDeltaMag)
{
	return pow(10.0f, clamp(InDeltaMag, UNI_DM_MIN, UNI_DM_MAX) * 0.2f);
}

UNI_FN float Uni_LimitingMag(float InDeltaMag)
{
	return UNI_M_REF + clamp(InDeltaMag, UNI_DM_MIN, UNI_DM_MAX);
}

/** Effective half-width used for level assignment: N - 1/K (D-118). A window lags the camera
 *  by one frame of motion, and velocity LOD bounds that motion to w / K for any active level,
 *  so an entering cell can be up to w / K closer than N cells. Assigning levels with N - 1/K
 *  makes entering objects lie beyond their relevance radius anyway: they stream in where they
 *  are already invisible, which is the design's no-pop claim, now actually true. */
static const float UNI_WINDOW_N_EFF = 1.75f;   // D-162: 5^3 at rest (reach 2 cells = N_eff + 1/K). 4^3 (1.25) measured 3.5-4x the resident objects: see D-162

/** D-162: the reach a level's window must cover around the camera, in its cells: the visible
 *  radius N_eff k plus one frame of motion (1/K). At dm = 0 it is 2 cells: a 5^3 window placed
 *  by the camera's position in its cell (UniWindow.h, PlaceWindowAxis). Capped at N_max.
 *  Smaller windows are not cheaper here: levels are octaves, so a smaller N_eff moves each slice
 *  up to cells twice as wide (D-162 measurement: 4^3 held 3.5-4x the objects of 5^3). */
UNI_FN float Uni_WindowReach(float InDeltaMag)
{
	const float K = Uni_SensitivityScale(InDeltaMag);
	return min(UNI_WINDOW_N_EFF * K + 1.0f / (float)UNI_VELOCITY_LOD_K, (float)UNI_WINDOW_N_MAX);
}

/** The bounding half-width of a window of that reach: ceil(reach), at most N_max. */
UNI_FN int Uni_WindowHalfWidth(float InDeltaMag)
{
	return min((int)ceil(Uni_WindowReach(InDeltaMag) - 1.0e-5f), UNI_WINDOW_N_MAX);
}

/** Render-only visibility fade: 1 at m <= m_lim - band, 0 at m >= m_lim (lesson #12). */
UNI_FN float Uni_MagFade(float InApparentMag, float InLimitingMag)
{
	return saturate((InLimitingMag - InApparentMag) / UNI_FADE_BAND);
}

/** Rec. 709 luminance. Sprite and volume radiance are colour / luminance x intensity, so the
 *  intensity (from the V magnitude) is the luminance and sums of many colours conserve it
 *  exactly when sprites hand light to the volume (D-135). */
UNI_FN float Uni_Luminance(float3 InRgb)
{
	return 0.2126f * InRgb.x + 0.7152f * InRgb.y + 0.0722f * InRgb.z;
}

/** Background horizon (D-131, render only): every flux is dimmed by (1 + r / r_H)^-2, the
 *  low-redshift form of cosmological surface-brightness dimming. Without it the integrated
 *  light of an endless (toroidal) universe diverges (Olbers). r_H = c / H0. Sprites and
 *  volumes use the same factor, so their sum is conserved (D-128). Visibility, relevance and
 *  level assignment use undimmed magnitudes, so content is unaffected. */
static const float UNI_HORIZON_CM = 1.37e28f;

UNI_FN float Uni_HorizonDimming(float InDistanceCm)
{
	const float X = 1.0f + InDistanceCm * (1.0f / UNI_HORIZON_CM);
	return 1.0f / (X * X);
}

/** Sprite intensity in exposure-calibrated units (lesson #36):
 *  10^(-0.4 (m - m_exposure)), faded across the band. */
UNI_FN float Uni_SpriteIntensity(float InApparentMag, float InExposureMag, float InLimitingMag)
{
	return pow(10.0f, -0.4f * (InApparentMag - InExposureMag)) * Uni_MagFade(InApparentMag, InLimitingMag);
}

#endif // UNI_PHOTOMETRY_USH
