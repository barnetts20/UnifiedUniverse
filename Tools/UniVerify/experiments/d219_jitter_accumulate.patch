+// ------------------------------------------------------------------------------------------
+// D-219: the accumulating resolve (CloudAtmosphere's MainResolveCS, our grids). D-184/D-194's
+// reconstruct took a marched pixel's sample as it was and an unmarched pixel's reprojected
+// history as it was, so it could not average jittered samples, and in motion a pixel held its
+// history resampled N^2 times. Here every pixel keeps an age (samples accumulated, and its own
+// samples alone; capped at 1 / FreshWeight):
+//  - a marched pixel blends its sample into its reprojected history at max(1 / (age + 1), FreshWeight);
+//  - the others blend in the fill (the 4 x 4 fresh samples about them, bilinear, depth-guided) at a
+//    share of 0.1 at rest (fading once the pixel holds a sample of its own) rising to 0.5 in motion;
+//  - the history is clamped to the fresh neighbourhood's mean +- gamma sigma (moments over a tent two
+//    cells wide, in radiance compressed by its brightest channel against 4 x the fill's luminance),
+//    gamma 4 at rest falling to 1 at TightPx of motion; what the clamp moves loses its age;
+//  - no usable history: the fill (a marched pixel: its own sample).
+// Pitfalls kept from CloudAtmosphere: moments about the nearest fresh sample are constant across a
+// cell and stamp the grid into the image in motion (the tent moves with the pixel); one non-finite
+// sample spreads through the moments (the march's output is finite by construction).
+// ------------------------------------------------------------------------------------------
+#define UNI_TEMPORAL_GAMMA_REST 4.0f
+#define UNI_TEMPORAL_GAMMA_MOTION 1.0f
+#define UNI_TEMPORAL_FILL_REST 0.1f
+#define UNI_TEMPORAL_FILL_MOTION 0.5f
+
+/** A pixel's place among the fresh samples: the fresh-lattice cell at or before it (-1 before the
+ *  first fresh column or row), the fraction across the cell, and whether it is this frame's. */
+UNI_FN void Uni_ResolveCell(uint2 InPx, uint InPhase, UNI_OUT(int2) OutBase, UNI_OUT(float2) OutFrac, UNI_OUT(uint) OutFresh)
+{
+	const int N = (int)Uni_TemporalN(InPhase);
+	const uint2 O = Uni_TemporalOffset(InPhase);
+	const int Rx = (int)InPx.x - (int)O.x, Ry = (int)InPx.y - (int)O.y;
+	const int Bx = (Rx + N) / N - 1, By = (Ry + N) / N - 1;
+	const int Mx = Rx - Bx * N, My = Ry - By * N;
+	OutBase = int2(Bx, By);
+	OutFrac = float2((float)Mx / (float)N, (float)My / (float)N);
+	OutFresh = Mx == 0 && My == 0 ? 1u : 0u;
+}
+
+/** Tap InTap (0..15, x fastest) of the 4 x 4 fresh samples about a cell: its march pixel (clamped
+ *  onto the grid), its fill weight (bilinear over the inner four) and moment weight (a tent two cells
+ *  wide), both 0 off the grid. Tap 5 is the cell's own sample. */
+UNI_FN uint2 Uni_ResolveTap(int2 InBase, float2 InFrac, uint InTap, uint InPhase, uint2 InSize, UNI_OUT(float) OutFillW, UNI_OUT(float) OutMomentW)
+{
+	const int N = (int)Uni_TemporalN(InPhase);
+	const uint2 O = Uni_TemporalOffset(InPhase);
+	const int Ox = (int)(InTap & 3u) - 1, Oy = (int)(InTap >> 2u) - 1;
+	const int Px = (InBase.x + Ox) * N + (int)O.x, Py = (InBase.y + Oy) * N + (int)O.y;
+	const bool bOn = InBase.x + Ox >= 0 && InBase.y + Oy >= 0 && Px < (int)InSize.x && Py < (int)InSize.y;
+	const float Dx = abs((float)Ox - InFrac.x), Dy = abs((float)Oy - InFrac.y);
+	OutFillW = bOn ? saturate(1.0f - Dx) * saturate(1.0f - Dy) : 0.0f;
+	OutMomentW = bOn ? saturate(1.0f - 0.5f * Dx) * saturate(1.0f - 0.5f * Dy) : 0.0f;
+	return uint2((uint)clamp(Px, 0, (int)InSize.x - 1), (uint)clamp(Py, 0, (int)InSize.y - 1));
+}
+
+/** Radiance compressed by its brightest channel against InKnee (4 x the fill's luminance: scale
+ *  free), so one bright sample cannot widen the moments to everything; transmittance as is. */
+UNI_FN float4 Uni_ResolveCompress(float4 InC, float InKnee)
+{
+	const float K = 1.0f / max(InKnee, 1.0e-30f);
+	const float Ex = InC.x * K, Ey = InC.y * K, Ez = InC.z * K;
+	const float D = 1.0f / (1.0f + max(Ex, max(Ey, Ez)));
+	return float4(Ex * D, Ey * D, Ez * D, InC.w);
+}
+
+UNI_FN float4 Uni_ResolveExpand(float4 InC, float InKnee)
+{
+	const float D = max(InKnee, 1.0e-30f) / max(1.0f - max(InC.x, max(InC.y, InC.z)), 1.0e-4f);
+	return float4(InC.x * D, InC.y * D, InC.z * D, InC.w);
+}
+
+/** The motion response (0 at rest, 1 from InTightPx march pixels of reprojection on). */
+UNI_FN float Uni_ResolveMotion(float InMotionPx, float InTightPx)
+{
+	return saturate(InMotionPx / max(InTightPx, 1.0e-3f));
+}
+
+/** The history clamped to the moments' mean +- gamma sigma (compressed space), and how far the
+ *  clamp moved it relative to the box's half width (0..1: the share of its age it loses). */
+UNI_FN float4 Uni_ResolveClamp(float4 InHistC, float4 InMean, float4 InSigma, float InMotion, UNI_OUT(float) OutReject)
+{
+	const float G = lerp(UNI_TEMPORAL_GAMMA_REST, UNI_TEMPORAL_GAMMA_MOTION, InMotion);
+	const float4 Lo = float4(InMean.x - G * InSigma.x, InMean.y - G * InSigma.y, InMean.z - G * InSigma.z, InMean.w - G * InSigma.w);
+	const float4 Hi = float4(InMean.x + G * InSigma.x, InMean.y + G * InSigma.y, InMean.z + G * InSigma.z, InMean.w + G * InSigma.w);
+	const float4 C = float4(clamp(InHistC.x, Lo.x, Hi.x), clamp(InHistC.y, Lo.y, Hi.y), clamp(InHistC.z, Lo.z, Hi.z), clamp(InHistC.w, Lo.w, Hi.w));
+	const float Rx = abs(InHistC.x - C.x) / (G * InSigma.x + 0.01f), Ry = abs(InHistC.y - C.y) / (G * InSigma.y + 0.01f);
+	const float Rz = abs(InHistC.z - C.z) / (G * InSigma.z + 0.01f), Rw = abs(InHistC.w - C.w) / (G * InSigma.w + 0.01f);
+	OutReject = saturate(max(max(Rx, Ry), max(Rz, Rw)));
+	return C;
+}
+
+/** A marched pixel's weight for its own sample: 1 / (samples + 1), at least InFreshWeight. */
+UNI_FN float Uni_ResolveAlpha(float InAge, float InFreshWeight)
+{
+	return max(1.0f / (InAge + 1.0f), InFreshWeight);
+}
+
+/** An unmarched pixel's share of the fill: 0.1 at rest while it holds no sample of its own (so the
+ *  history converges to its own samples), 0.5 in motion. */
+UNI_FN float Uni_ResolveShare(float InOwnAge, float InMotion)
+{
+	return lerp(UNI_TEMPORAL_FILL_REST * saturate(1.0f - InOwnAge), UNI_TEMPORAL_FILL_MOTION, InMotion);
+}
